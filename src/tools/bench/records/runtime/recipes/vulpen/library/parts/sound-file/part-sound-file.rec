# The rows of src/runtime/recipes/vulpen/library/parts/sound-file/SoundFile.cpp, a call each (src/tools/bench/bench.py).

## SoundFile.cpp/SoundFile::bind
[("file", "/s/a.wav"), ("loop", "maybe"), ("volume", "1")] -> throws runtime_error: "loop = maybe is not yes or no"; asked []
[("file", "/s/a.wav"), ("loop", "yes"), ("volume", "1")] -> ["param volume read as float", "file /s/a.wav"]
[("loop", "no"), ("volume", "0.5")] -> ["param volume read as float"]

## SoundFile.cpp/SoundFile::cook
a file not there, 2 frames -> added [0, 0, 0, 0]; logged ["error: <here>/gone.wav is empty, or not there"]
a.wav at half volume, 2 frames -> added [0.25, -0.25, 0.125, -0.125]; logged []
a.wav looped, 3 frames -> added [0.5, -0.5, 0.25, -0.25, 0.5, -0.5]; logged []
a.wav once, 3 frames -> added [0.5, -0.5, 0.25, -0.25, 0, 0]; logged []
a.wav once, its version moved, 1 frames -> added [0.5, -0.5]; logged []
a.wav once, played out, 3 frames -> added [0, 0, 0, 0, 0, 0]; logged []
no file -> logged []
