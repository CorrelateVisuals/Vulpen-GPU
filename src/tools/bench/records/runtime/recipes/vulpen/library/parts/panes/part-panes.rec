no to param -> 1 ["ide: node add ide.p1-pane recipe=still-image", "ide: node move ide.p1-pane ide.panes", "ide: connect p1-pane-room ide.deck.p1 ide.p1-pane.image.area ide.p1-pane.still.area", "ide: node add ide.p2-pane recipe=still-image", "ide: node move ide.p2-pane ide.panes", "ide: connect p2-pane-room ide.deck.p2 ide.p2-pane.image.area ide.p2-pane.still.area", "ide: disconnect typed", "ide: connect typed ide.keys.typed ide.panes.typed", "ide: connect present p2:  ide.p2-pane.image.picture ide.p2-pane.still.picture"]; 2 []
