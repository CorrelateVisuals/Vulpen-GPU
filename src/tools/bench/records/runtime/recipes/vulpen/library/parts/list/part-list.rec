# The rows of src/runtime/recipes/vulpen/library/parts/list/List.cpp, a call each (src/tools/bench/bench.py).

## List.cpp/List::back
frame 0, a press on gpu -> run (0,0)+(40,20) panel
frame 1, a press on run -> run (0,0)+(40,20) panel blending error 1
frame 16 -> run (0,0)+(40,20) panel blending error 0.5
frame 30 -> run (0,0)+(40,20) panel blending error 0.03333336
frame 31 -> run (0,0)+(40,20) panel
frame 40, a press below it -> run (0,0)+(40,20) panel
frame 41, a press as the pointer moves onto it, then off -> run (0,0)+(40,20) panel blending error 1

## List.cpp/List::bind
[("axis", "x"), ("drop", "no"), ("end", "2")] -> ["param end read as uint", "input items", "input place", "input font", "upload rects of 32 bytes , room 67", "upload labels of 40 bytes , room 129", "upload characters of 12 bytes , room 4096", "output shown", "output marks", "output current"]
[("axis", "y"), ("drop", "below"), ("end", "0")] -> ["param end read as uint", "input items", "input place", "input font", "upload rects of 32 bytes , room 67", "upload labels of 40 bytes , room 129", "upload characters of 12 bytes , room 4096", "output shown", "output marks", "output current"]
[("axis", "y"), ("drop", "no"), ("end", "-1")] -> ["param end read as uint, refused", "input items", "input place", "input font", "upload rects of 32 bytes , room 67", "upload labels of 40 bytes , room 129", "upload characters of 12 bytes , room 4096", "output shown", "output marks", "output current"]
[("axis", "y"), ("drop", "no"), ("end", "0")] -> ["param end read as uint", "input items", "input place", "input font", "upload rects of 32 bytes , room 67", "upload labels of 40 bytes , room 129", "upload characters of 12 bytes , room 4096", "output shown", "output marks", "output current"]
[("axis", "y"), ("drop", "right"), ("end", "0")] -> ["param end read as uint", "input items", "input place", "input font", "upload rects of 32 bytes , room 67", "upload labels of 40 bytes , room 129", "upload characters of 12 bytes , room 4096", "output shown", "output marks", "output current"]
[("axis", "y"), ("drop", "up"), ("end", "0")] -> throws runtime_error: "param drop = up: no, below or right"
[("axis", "z"), ("drop", "no"), ("end", "0")] -> throws runtime_error: "param axis = z: x or y"

