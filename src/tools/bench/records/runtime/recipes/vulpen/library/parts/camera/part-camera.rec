# The rows of src/runtime/recipes/vulpen/library/parts/camera/Camera.cpp, a call each (src/tools/bench/bench.py).

## Camera.cpp/Camera::bind
a ground connected -> ["upload camera of 64 bytes , room 1", "param target read as vec3", "param eye read as vec3", "param up read as vec3", "param lens read as float", "param frames_per_turn read as uint", "param near read as float", "param far read as float", "param glide_speed read as float", "param ground_margin read as float", "input ground"]
another node's ground connected -> ["upload camera of 64 bytes , room 1", "param target read as vec3", "param eye read as vec3", "param up read as vec3", "param lens read as float", "param frames_per_turn read as uint", "param near read as float", "param far read as float", "param glide_speed read as float", "param ground_margin read as float"]
as dropped -> ["upload camera of 64 bytes , room 1", "param target read as vec3", "param eye read as vec3", "param up read as vec3", "param lens read as float", "param frames_per_turn read as uint", "param near read as float", "param far read as float", "param glide_speed read as float", "param ground_margin read as float"]
double_click x -> throws runtime_error: "param double_click = x: home or none"
eye on the target -> throws runtime_error: "eye, target and up leave no frame: eye must lie off the target, and up off the line between them"
far at near -> throws runtime_error: "near must lie beyond 0, and far beyond near"
far below near -> throws runtime_error: "near must lie beyond 0, and far beyond near"
glide_speed -1 -> throws runtime_error: "glide_speed and ground_margin must be 0 or more"
ground_margin -1 -> throws runtime_error: "glide_speed and ground_margin must be 0 or more"
ground_margin 0 -> ["upload camera of 64 bytes , room 1", "param target read as vec3", "param eye read as vec3", "param up read as vec3", "param lens read as float", "param frames_per_turn read as uint", "param near read as float", "param far read as float", "param glide_speed read as float", "param ground_margin read as float"]
lens -1 -> throws runtime_error: "param lens = -1: beyond 0"
lens 0 -> throws runtime_error: "param lens = 0: beyond 0"
lens nan -> throws runtime_error: "param lens = 0: beyond 0"
near 0 -> throws runtime_error: "near must lie beyond 0, and far beyond near"
turn x -> throws runtime_error: "param turn = x: ball or level"
up along the line of sight -> throws runtime_error: "eye, target and up leave no frame: eye must lie off the target, and up off the line between them"

