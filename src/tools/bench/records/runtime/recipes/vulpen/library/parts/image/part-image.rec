# The rows of src/runtime/recipes/vulpen/library/parts/image/Image.cpp, a call each (src/tools/bench/bench.py).

## Image.cpp/Image::bind
[("moves", "maybe"), ("interact", "no")] -> throws runtime_error: "param moves = maybe: yes or no"
[("moves", "no"), ("interact", "no")] -> ["input area", "upload place of 32 bytes , room 0", "value pan as vec2", "value zoom as float", "value holds as uint", "value loading as uint"]
[("moves", "no"), ("interact", "no")], a still connected -> ["input area", "upload place of 32 bytes , room 0", "value pan as vec2", "value zoom as float", "value holds as uint", "value loading as uint", "input still"]
[("moves", "yes"), ("interact", "no")] -> ["input area", "upload place of 32 bytes , room 0", "value pan as vec2", "value zoom as float", "input typed", "value holds as uint", "value loading as uint"]
[("moves", "yes"), ("interact", "x")] -> throws runtime_error: "param interact = x: yes or no"

