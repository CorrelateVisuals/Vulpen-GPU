# The rows of src/runtime/recipes/vulpen/library/parts/snapshot/Snapshot.cpp, a call each (src/tools/bench/bench.py).

## Snapshot.cpp/Snapshot::bind
[("frames", "0"), ("wait", "30")] -> throws runtime_error: "param frames = 0: from 1 to 3600"
[("frames", "1"), ("wait", "30")] -> ["param frames read as uint", "param wait read as uint", "value shoot as uint", "readback pixels of 4 bytes uint"]
[("frames", "3600"), ("wait", "30"), ("file", "a.png")] -> ["param frames read as uint", "param wait read as uint", "value shoot as uint", "readback pixels of 4 bytes uint"]
[("frames", "3601"), ("wait", "30")] -> throws runtime_error: "param frames = 3601: from 1 to 3600"
[("frames", "x"), ("wait", "30")] -> throws runtime_error: "param frames = 0: from 1 to 3600"

