## Edits.cpp/check_ends
[n a b.in] -> throws runtime_error: "a is not node.port, as a.out, or a: for its view's window"
[n a.out b.in zz] -> throws runtime_error: "zz is not node.port"
[n a.out b.in] -> passes
[n a.out b] -> throws runtime_error: "b is not node.port, as b.in"
[n a.out d] -> throws runtime_error: "d is not node.port, as d.in1"
[n b a.in] -> throws runtime_error: "b is not node.port, as b.out"
[n b.out a] -> throws runtime_error: "a is not node.port, as a.in, or a: for its view's window"
[n c a.in] -> throws runtime_error: "c is not node.port"
[n d a.in] -> throws runtime_error: "d is not node.port, as d.out1"
[n game a.in] -> throws runtime_error: "game is not node.port, or game: for its view's window"
[n game: a.in] -> passes

## Edits.cpp/check_spaced
[= 6] -> passes
[a b] -> passes
[a=1 =2] -> passes
[a=1 b = 6] -> throws runtime_error: "b is not word=value: b=6"
[a=1 b =6] -> throws runtime_error: "b is not word=value: b=6"
[vertex_count = 6] -> throws runtime_error: "vertex_count is not word=value: vertex_count=6"
[vertex_count =6] -> throws runtime_error: "vertex_count is not word=value: vertex_count=6"
[vertex_count =] -> throws runtime_error: "vertex_count is not word=value: vertex_count="

