# The rows of src/runtime/Runtime.h and src/runtime/Runtime.cpp, a call each (src/tools/bench/bench.py).

## Runtime.cpp/Feed
1 a press: pointer 10,10, button "left" down x1
2 let go and pressed again where it was: button "left" up, button "left" down x2
3 a third: button "left" up, button "left" down x3
4 a fourth, 6 pixels off either way: pointer 16,4, button "left" up, button "left" down x4
5 7 pixels off: pointer 23,4, button "left" up, button "left" down x1
6 another button between: button "right" down x1, button "right" up, button "left" down x1
7 past the interval: button "left" up, button "left" down x1
8 keys, text, the wheel and focus: key "a" down, text "\xc3\xa9", wheel 0,-1, focus off, focus on, key "a" up
9 the frame after: nothing

## Runtime.cpp/Preference::read
("  prefer  =  discrete  \n") -> "takes \"discrete\""
("") -> "none named"
("# The kind of GPU vulpen takes first here; gpu toggle writes it.\nprefer = integrated\n") -> "takes \"integrated\""
("PREFER = discrete\n") -> "none named"
("\xef\xbb\xbfprefer = discrete\n") -> "none named"
("prefer = Discrete\n") -> "throws \"<here>/gpu.ini: prefer = Discrete is no kind of GPU: integrated or discrete\""
("prefer = discrete # the fast one\n") -> "throws \"<here>/gpu.ini: prefer = discrete # the fast one is no kind of GPU: integrated or discrete\""
("prefer = discrete\n") -> "takes \"discrete\""
("prefer = discrete\nprefer = integrated\n") -> "takes \"discrete\""
("prefer = discrete\r\n") -> "takes \"discrete\""
("prefer = gpu\n") -> "throws \"<here>/gpu.ini: prefer = gpu is no kind of GPU: integrated or discrete\""
("prefer =\n") -> "throws \"<here>/gpu.ini: prefer =  is no kind of GPU: integrated or discrete\""
("prefer discrete\n") -> "none named"
("prefer=integrated") -> "takes \"integrated\""
("preferred = discrete\n") -> "none named"
("x = 1\nprefer = integrated\n") -> "takes \"integrated\""
~("  prefer  =  discrete  \n  prefer  =  discrete  \n") -> "takes \"discrete\""
~("  prefer  =  discrete  \nprefer =\n") -> "takes \"discrete\""
~("# The kind of GPU vulpen takes first here; gpu toggle writes it.\nprefer = integrated\n  prefer  =  discrete  \n") -> "takes \"integrated\""
~("PREFER = discrete\nprefer=integrated") -> "takes \"integrated\""
~("\xef\xbb\xbfprefer = discrete\n  prefer  =  discrete  \n") -> "takes \"discrete\""
~("\xef\xbb\xbfprefer = discrete\nprefer = discrete\nprefer = integrated\n") -> "takes \"discrete\""
~("prefer = Discrete\nprefer=integrated") -> "throws \"<here>/gpu.ini: prefer = Discrete is no kind of GPU: integrated or discrete\""
~("prefer = discrete # the fast one\n# The kind of GPU vulpen takes first here; gpu toggle writes it.\nprefer = integrated\n") -> "throws \"<here>/gpu.ini: prefer = discrete # the fast one is no kind of GPU: integrated or discrete\""
~("prefer = discrete # the fast one\nprefer = discrete\n") -> "throws \"<here>/gpu.ini: prefer = discrete # the fast one is no kind of GPU: integrated or discrete\""
~("prefer = discrete # the fast one\nprefer = discrete\nprefer = integrated\n") -> "throws \"<here>/gpu.ini: prefer = discrete # the fast one is no kind of GPU: integrated or discrete\""
~("prefer = discrete # the fast one\nprefer =\n") -> "throws \"<here>/gpu.ini: prefer = discrete # the fast one is no kind of GPU: integrated or discrete\""
~("prefer = discrete\nprefer = gpu\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer = integrated\nprefer = Discrete\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer = integrated\nprefer = discrete\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer = integrated\nprefer = discrete\nprefer = integrated\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer = integrated\nprefer = discrete\r\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer = integrated\npreferred = discrete\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer = integrated\nx = 1\nprefer = integrated\n") -> "takes \"discrete\""
~("prefer = discrete\nprefer =\n") -> "takes \"discrete\""
~("prefer = discrete\nx = 1\nprefer = integrated\n") -> "takes \"discrete\""
~("prefer = discrete\r\nPREFER = discrete\n") -> "takes \"discrete\""
~("prefer = gpu\nprefer = discrete # the fast one\n") -> "throws \"<here>/gpu.ini: prefer = gpu is no kind of GPU: integrated or discrete\""
~("prefer = gpu\nprefer = discrete\r\n") -> "throws \"<here>/gpu.ini: prefer = gpu is no kind of GPU: integrated or discrete\""
~("prefer =\nprefer=integrated") -> "throws \"<here>/gpu.ini: prefer =  is no kind of GPU: integrated or discrete\""
~("prefer discrete\n# The kind of GPU vulpen takes first here; gpu toggle writes it.\nprefer = integrated\n") -> "takes \"integrated\""
~("prefer discrete\n\xef\xbb\xbfprefer = discrete\n") -> "none named"
~("prefer discrete\nprefer = Discrete\n") -> "throws \"<here>/gpu.ini: prefer = Discrete is no kind of GPU: integrated or discrete\""
~("prefer discrete\nprefer = gpu\n") -> "throws \"<here>/gpu.ini: prefer = gpu is no kind of GPU: integrated or discrete\""
~("prefer discrete\nprefer discrete\n") -> "none named"
~("prefer discrete\nx = 1\nprefer = integrated\n") -> "takes \"integrated\""
~("prefer=integratedprefer = discrete # the fast one\n") -> "throws \"<here>/gpu.ini: prefer = integratedprefer = discrete # the fast one is no kind of GPU: integrated or discrete\""
~("prefer=integratedpreferred = discrete\n") -> "throws \"<here>/gpu.ini: prefer = integratedpreferred = discrete is no kind of GPU: integrated or discrete\""
~("prefer=integratedx = 1\nprefer = integrated\n") -> "throws \"<here>/gpu.ini: prefer = integratedx = 1 is no kind of GPU: integrated or discrete\""
~("preferred = discrete\nPREFER = discrete\n") -> "none named"
~("preferred = discrete\nprefer = discrete\r\n") -> "takes \"discrete\""
~("x = 1\nprefer = integrated\nprefer = gpu\n") -> "takes \"integrated\""

## Runtime.cpp/Preference::read, no file
a launch with no gpu.ini takes the fastest

## Runtime.cpp/Runtime::parse
(["--frames", "2"]) -> "manifest \"\" hosted [] frames 2 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--"]) -> "throws \"unknown argument --\""
(["a.vlp", "--first-frame", "18446744073709551615"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 18446744073709551615 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--fps", "0"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 0 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--fps", "4294967296"]) -> "throws \"--fps 4294967296 is not a whole number\""
(["a.vlp", "--frames", "-1"]) -> "throws \"--frames -1 is not a whole number\""
(["a.vlp", "--frames", "1e3"]) -> "throws \"--frames 1e3 is not a whole number\""
(["a.vlp", "--frames", "2", "--frames", "3"]) -> "throws \"--frames is given twice\""
(["a.vlp", "--frames", "2"]) -> "manifest \"a.vlp\" hosted [] frames 2 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--frames"]) -> "throws \"--frames needs a value\""
(["a.vlp", "--frames=2"]) -> "throws \"unknown argument --frames=2; a value follows its flag after a blank, as --frames 2\""
(["a.vlp", "--log", "DEBUG"]) -> "throws \"--log DEBUG is no level\""
(["a.vlp", "--log", "debug"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 60 size 0x0 log 3 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--log", "nope"]) -> "throws \"--log nope is no level\""
(["a.vlp", "--log-file", ""]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--nope", "x"]) -> "throws \"unknown argument --nope\""
(["a.vlp", "--size", "0x0"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--size", "1280"]) -> "throws \"--size 1280 is no size: a width and a height, as 1280x720\""
(["a.vlp", "--size", "1280X720"]) -> "throws \"--size 1280X720 is no size: a width and a height, as 1280x720\""
(["a.vlp", "--size", "1280x"]) -> "throws \"--size 1280x is no size: a width and a height, as 1280x720\""
(["a.vlp", "--size", "1280x720"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 60 size 1280x720 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "--size", "1280x720x3"]) -> "throws \"--size 1280x720x3 is no size: a width and a height, as 1280x720\""
(["a.vlp", "--size", "x"]) -> "throws \"--size x is no size: a width and a height, as 1280x720\""
(["a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"s.txt\" restart \"r.log\""
(["a.vlp", "-frames", "2"]) -> "manifest \"a.vlp\" hosted [-frames 2] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp", "b.vlp", "c.vlp"]) -> "manifest \"a.vlp\" hosted [b.vlp c.vlp] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
(["a.vlp"]) -> "manifest \"a.vlp\" hosted [] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
([]) -> "manifest \"\" hosted [] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "--", "a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "throws \"unknown argument --\""
~(["a.vlp", "--first-frame", "18446744073709551615", "a.vlp", "--frames", "1e3"]) -> "throws \"--frames 1e3 is not a whole number\""
~(["a.vlp", "--first-frame", "18446744073709551615", "a.vlp", "--size", "1280X720"]) -> "throws \"--size 1280X720 is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--fps", "0", "a.vlp", "--frames", "1e3"]) -> "throws \"--frames 1e3 is not a whole number\""
~(["a.vlp", "--fps", "0", "a.vlp"]) -> "manifest \"a.vlp\" hosted [a.vlp] frames 0 first 0 fps 0 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "--fps", "4294967296", "a.vlp", "--fps", "0"]) -> "throws \"--fps 4294967296 is not a whole number\""
~(["a.vlp", "--fps", "4294967296", "a.vlp", "--log", "nope"]) -> "throws \"--fps 4294967296 is not a whole number\""
~(["a.vlp", "--fps", "4294967296", "a.vlp", "b.vlp", "c.vlp"]) -> "throws \"--fps 4294967296 is not a whole number\""
~(["a.vlp", "--frames", "-1", "a.vlp", "--first-frame", "18446744073709551615"]) -> "throws \"--frames -1 is not a whole number\""
~(["a.vlp", "--frames", "-1", "a.vlp", "b.vlp", "c.vlp"]) -> "throws \"--frames -1 is not a whole number\""
~(["a.vlp", "--frames", "1e3", "a.vlp", "--log", "DEBUG"]) -> "throws \"--frames 1e3 is not a whole number\""
~(["a.vlp", "--frames", "1e3", "a.vlp", "--log", "debug"]) -> "throws \"--frames 1e3 is not a whole number\""
~(["a.vlp", "--frames", "2", "--frames", "3", "a.vlp", "--size", "1280"]) -> "throws \"--frames is given twice\""
~(["a.vlp", "--frames", "2", "--frames", "3", "a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "throws \"--frames is given twice\""
~(["a.vlp", "--frames", "a.vlp", "--fps", "0"]) -> "throws \"--frames a.vlp is not a whole number\""
~(["a.vlp", "--frames", "a.vlp", "--frames", "-1"]) -> "throws \"--frames a.vlp is not a whole number\""
~(["a.vlp", "--frames", "a.vlp", "--size", "1280x720"]) -> "throws \"--frames a.vlp is not a whole number\""
~(["a.vlp", "--frames=2", "a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "throws \"unknown argument --frames=2; a value follows its flag after a blank, as --frames 2\""
~(["a.vlp", "--log", "DEBUG", "a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "throws \"--log DEBUG is no level\""
~(["a.vlp", "--log", "debug", "a.vlp", "--"]) -> "throws \"unknown argument --\""
~(["a.vlp", "--log", "debug", "a.vlp", "--frames", "-1"]) -> "throws \"--frames -1 is not a whole number\""
~(["a.vlp", "--log", "debug", "a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "manifest \"a.vlp\" hosted [a.vlp] frames 0 first 0 fps 60 size 0x0 log 3 log-file \"\" source \"s.txt\" restart \"r.log\""
~(["a.vlp", "--log", "debug", "a.vlp"]) -> "manifest \"a.vlp\" hosted [a.vlp] frames 0 first 0 fps 60 size 0x0 log 3 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "--log", "nope", "--frames", "2"]) -> "throws \"--log nope is no level\""
~(["a.vlp", "--log", "nope", "a.vlp", "--frames", "2", "--frames", "3"]) -> "throws \"--log nope is no level\""
~(["a.vlp", "--nope", "x", "--frames", "2"]) -> "throws \"unknown argument --nope\""
~(["a.vlp", "--nope", "x", "a.vlp", "--log", "nope"]) -> "throws \"unknown argument --nope\""
~(["a.vlp", "--nope", "x", "a.vlp", "--size", "1280x"]) -> "throws \"unknown argument --nope\""
~(["a.vlp", "--nope", "x", "a.vlp", "b.vlp", "c.vlp"]) -> "throws \"unknown argument --nope\""
~(["a.vlp", "--size", "0x0", "a.vlp", "--"]) -> "throws \"unknown argument --\""
~(["a.vlp", "--size", "0x0", "a.vlp", "--frames", "2"]) -> "manifest \"a.vlp\" hosted [a.vlp] frames 2 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "--size", "1280X720", "a.vlp", "--frames", "1e3"]) -> "throws \"--size 1280X720 is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "1280X720", "a.vlp", "--source", "s.txt", "--restart", "r.log"]) -> "throws \"--size 1280X720 is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "1280x", "a.vlp", "--fps", "4294967296"]) -> "throws \"--size 1280x is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "1280x", "a.vlp", "--frames", "1e3"]) -> "throws \"--size 1280x is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "1280x", "a.vlp", "--frames=2"]) -> "throws \"--size 1280x is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "1280x", "a.vlp", "--size", "x"]) -> "throws \"--size 1280x is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "x", "a.vlp", "--size", "0x0"]) -> "throws \"--size x is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--size", "x", "a.vlp"]) -> "throws \"--size x is no size: a width and a height, as 1280x720\""
~(["a.vlp", "--source", "s.txt", "--restart", "r.log", "a.vlp", "--size", "1280X720"]) -> "throws \"--size 1280X720 is no size: a width and a height, as 1280x720\""
~(["a.vlp", "-frames", "2", "a.vlp", "--log", "debug"]) -> "manifest \"a.vlp\" hosted [-frames 2 a.vlp] frames 0 first 0 fps 60 size 0x0 log 3 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "a.vlp", "--log", "debug"]) -> "manifest \"a.vlp\" hosted [a.vlp] frames 0 first 0 fps 60 size 0x0 log 3 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "a.vlp", "b.vlp", "c.vlp"]) -> "manifest \"a.vlp\" hosted [a.vlp b.vlp c.vlp] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "a.vlp"]) -> "manifest \"a.vlp\" hosted [a.vlp] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "b.vlp", "c.vlp", "a.vlp", "--fps", "0"]) -> "manifest \"a.vlp\" hosted [b.vlp c.vlp a.vlp] frames 0 first 0 fps 0 size 0x0 log 1 log-file \"\" source \"\" restart \"\""
~(["a.vlp", "b.vlp", "c.vlp", "a.vlp", "-frames", "2"]) -> "manifest \"a.vlp\" hosted [b.vlp c.vlp a.vlp -frames 2] frames 0 first 0 fps 60 size 0x0 log 1 log-file \"\" source \"\" restart \"\""

