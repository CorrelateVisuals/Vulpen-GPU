## Bound.h/is_draw and the stage rules
(["A.comp", "A.cpp"]) -> "vertex false fragment false draw false lacks false operator true"
(["A.comp"]) -> "vertex false fragment false draw false lacks false operator false"
(["A.cpp"]) -> "vertex false fragment false draw false lacks false operator true"
(["A.frag"]) -> "vertex false fragment true draw false lacks false operator false"
(["A.geom"]) -> "vertex false fragment false draw false lacks true operator false"
(["A.vert", "A.frag", "A.cpp"]) -> "vertex false fragment false draw true lacks false operator true"
(["A.vert", "A.frag"]) -> "vertex false fragment false draw true lacks false operator false"
(["A.vert", "A.geom", "A.frag"]) -> "vertex false fragment false draw true lacks false operator false"
(["A.vert", "A.tesc", "A.frag"]) -> "vertex false fragment false draw false lacks true operator false"
(["A.vert", "A.tesc", "A.tese", "A.frag"]) -> "vertex false fragment false draw true lacks false operator false"
(["A.vert"]) -> "vertex true fragment false draw true lacks false operator false"
([]) -> "vertex false fragment false draw false lacks false operator false"

## Bound.h/joining
(view "chain" #756c4f17, "") -> "connect   b.in c.in"
(view "chain" #756c4f17, ".") -> "connect  . b.in c.in"
(view "chain" #756c4f17, ".a") -> "connect a .a b.in c.in"
(view "chain" #756c4f17, "\xc3\xa9.a") -> "connect a \xc3\xa9.a b.in c.in"
