copy, then clipboard -> "copied \xc3\xa9"
made 640x480 -> size 640x480
poll with nothing sent -> open true
the device goes -> done

## Platform.cpp/Window, its desktop calls
fullscreen false -> done; on a monitor false, size 640x480
fullscreen false -> done; on a monitor false, size 640x480
fullscreen true -> done; on a monitor true, size 1280x720
fullscreen true -> done; on a monitor true, size 1280x720
lock_pointer false -> cursor normal, raw motion 0 (offered 1)
lock_pointer true -> cursor disabled, raw motion 1 (offered 1)
the device goes -> done
title -> "a title, \xc3\xa9"
two polls, no gamepad present -> 0 keys or axes handed on

