# The rows of src/baseclasses/Platform.h and src/baseclasses/Platform.cpp, a call each (src/tools/bench/bench.py).

## Platform.cpp/Files beside a person's .tmp
copy a to x beside x.tmp, a file -> done; then [a=1, x.tmp=mine, x=1]
copy a to x beside x.tmp/, a folder -> done; then [a=1, x.tmp/, x.tmp/keep=mine, x=1]
copy d/ to x beside x.tmp/, a folder -> done; then [d/, d/b=2, x.tmp/, x.tmp/keep=mine, x/, x/b=2]
save a beside a.tmp, a file -> done; then [a.tmp=mine, a=2]
save a beside a.tmp/, a folder -> done; then [a.tmp/, a.tmp/keep=mine, a=2]

