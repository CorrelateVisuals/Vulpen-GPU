## Platform.cpp/Files::copy
(["a=1", "a.tmp=mine"], "..", "a") -> "throws \"<here>/a exists already\"; then [a.tmp=mine, a=1]"
(["a=1", "a.tmp=mine"], "a", "..") -> "throws \"<here>/.. exists already\"; then [a.tmp=mine, a=1]"
(["a=1", "a.tmp=mine"], "a", "a") -> "throws \"<here>/a exists already\"; then [a.tmp=mine, a=1]"
(["a=1", "a.tmp=mine"], "a", "d") -> "done; then [a.tmp=mine, a=1, d=1]"
(["a=1", "a.tmp=mine"], "a", "d.tmp") -> "done; then [a.tmp=mine, a=1, d.tmp=1]"
(["a=1", "a.tmp=mine"], "a", "d/../a") -> "throws \"<here>/d/../a is inside <here>/a, so it cannot hold a copy of it\"; then [a.tmp=mine, a=1]"
(["a=1", "a.tmp=mine"], "a", "d/e") -> "done; then [a.tmp=mine, a=1, d/, d/e=1]"
(["a=1", "a.tmp=mine"], "a", "d/x") -> "done; then [a.tmp=mine, a=1, d/, d/x=1]"
