~("b\r b\tb", "\r", error) -> printed ["{!!!} n: \\x0d"] kept [info "{run} bench", error "{!!!} n: \\x0d"]
~("b\r\r  b", "\x1b \n\t\nb\x1b", error) -> printed ["{!!!} n: \\x1b ", "{!!!} n: \t", "{!!!} n: b\\x1b"] kept [info "{run} bench", error "{!!!} n: \\x1b ", error "{!!!} n: \t", error "{!!!} n: b\\x1b"]
~("b\x1b \x1b\n", "\r b\x1b\r\r\n\n", error) -> printed ["{!!!} n: \\x0d b\\x1b\\x0d\\x0d", "{!!!} n: "] kept [info "{run} bench", error "{!!!} n: \\x0d b\\x1b\\x0d\\x0d", error "{!!!} n: "]
~("bb \nb\t", "b\rbb", error) -> printed ["{!!!} n: b\\x0dbb"] kept [info "{run} bench", error "{!!!} n: b\\x0dbb"]

## Log.cpp/Printed, a character at a time
"ab" and std::endl, put 'c' and '\n', to errors put 'e' and std::endl -> printed ["{out} n: ab", "{out} n: c", "{!!!} n: e"] kept [info "{out} n: ab", info "{out} n: c", error "{!!!} n: e"]

