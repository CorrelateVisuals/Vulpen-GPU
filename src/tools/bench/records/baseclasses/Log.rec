(debug, warn, {run}, "\x1b[2J") -> printed ["{ ! } \\x1b[2J"] kept [warn "{ ! } \\x1b[2J"]
(debug, warn, {run}, "\x7f") -> printed ["{ ! } \\x7f"] kept [warn "{ ! } \\x7f"]
(debug, warn, {run}, "\xc3\xa9") -> printed ["{ ! } \xc3\xa9"] kept [warn "{ ! } \xc3\xa9"]
