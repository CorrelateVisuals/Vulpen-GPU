(debug, warn, {run}, "a\nb") -> printed ["{ ! } a", "      b"] kept [warn "{ ! } a\nb"]
(debug, warn, {run}, "a\r") -> printed ["{ ! } a\\x0d"] kept [warn "{ ! } a\\x0d"]
(debug, warn, {run}, "a\r\nb") -> printed ["{ ! } a\\x0d", "      b"] kept [warn "{ ! } a\\x0d\nb"]
