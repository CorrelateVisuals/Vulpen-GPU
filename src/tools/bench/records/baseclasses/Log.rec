## Log.cpp/Log::clears_row
(false) then a warning; printed "<clock>            { ! } a\n"
(true) then a warning; printed "\r\x1b[K<clock>            { ! } a\n"

## Log.cpp/Log::kept
([""], debug, "") -> true
([""], error, "") -> true
([""], info, "") -> true
([""], warn, "") -> true
([""], warn, "a") -> true
([""], warn, "b") -> true
([""], warn, "ide") -> true
(["a", "b"], debug, "") -> true
(["a", "b"], error, "") -> true
(["a", "b"], info, "") -> true
(["a", "b"], warn, "") -> true
(["a", "b"], warn, "a") -> true
(["a", "b"], warn, "b") -> true
(["a", "b"], warn, "ide") -> true
(["a"], debug, "") -> true
(["a"], debug, "a") -> true
(["a"], debug, "b") -> false
(["a"], debug, "ide") -> false
(["a"], error, "") -> true
(["a"], error, "a") -> true
(["a"], error, "b") -> true
(["a"], error, "ide") -> true
(["a"], info, "") -> true
(["a"], info, "a") -> true
(["a"], info, "b") -> false
(["a"], info, "ide") -> false
(["a"], warn, "") -> true
(["a"], warn, "a") -> true
(["a"], warn, "b") -> true
(["a"], warn, "ide") -> true
(["ide"], debug, "") -> true
(["ide"], error, "") -> true
(["ide"], info, "") -> true
(["ide"], warn, "") -> true
(["ide"], warn, "a") -> true
(["ide"], warn, "b") -> true
(["ide"], warn, "ide") -> true
([], debug, "") -> true
([], error, "") -> true
([], info, "") -> true
([], warn, "") -> true
([], warn, "a") -> true
([], warn, "b") -> true
([], warn, "ide") -> true
~([""], error, "ide") -> true
~([""], info, "ide") -> false
~(["a", "b"], debug, "b") -> true
~(["a", "b"], error, "a") -> true
~(["a", "b"], error, "b") -> true
~(["ide"], debug, "ide") -> true
~(["ide"], error, "a") -> true
~([], debug, "a") -> true
~([], debug, "b") -> true
~([], info, "b") -> true
~([], info, "ide") -> true

## Log.cpp/Log::print repeats
(0, false, "") -> printed ["{run} other"] kept [info "{run} bench", info "{run} other"]
(0, true, "") -> printed ["{run} other"] kept [info "{run} bench", info "{run} other"]
(0, true, "a") -> printed ["{run} other"] kept [info "{run} bench", info "{run} other"]
(0, true, "b") -> printed ["{run} other"] kept [info "{run} bench", info "{run} other"]
(0, true, "ide") -> printed ["{run} other"] kept [info "{run} bench", info "{run} other"]
(1, false, "") -> printed ["{nod} a: same", "{run} other"] kept [info "{run} bench", info "{nod} a: same", info "{run} other"]
(1, false, "a") -> printed ["{nod} a: same", "{run} other"] kept [info "{run} bench", info "{nod} a: same", info "{run} other"]
