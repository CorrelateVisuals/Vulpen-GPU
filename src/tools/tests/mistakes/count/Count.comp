#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 4) in;

layout(set = 1, binding = 0) uniform Pass {
  DrawCounts drawn; // the instances crowd draws, which the frame zeroes first
} pass;

// One more instance for crowd from each invocation, counted on the GPU.
void main() {
  atomicAdd(pass.drawn.at[0].instance_count, 1);
}
