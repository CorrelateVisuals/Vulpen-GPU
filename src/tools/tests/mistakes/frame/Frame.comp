#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 6) in;

VP_WRITES(Seen, float);

// The params after the buffer, a vec3 where std140 aligns it to 16 bytes and a float in
// the vec3's fourth place, so a vector written anywhere but where reflection says shows.
layout(set = 1, binding = 0) uniform Pass {
  Seen seen;   // the frame block and the params as this pass read them, a value each
  vec3 tint;   // a param
  float after; // a param
  vec2 at;     // a param
} pass;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const float seen[12] = float[12](float(frame.resolution.x),
                                   float(frame.resolution.y),
                                   frame.cursor.x,
                                   frame.cursor.y,
                                   frame.time,
                                   float(frame.index),
                                   pass.tint.x,
                                   pass.tint.y,
                                   pass.tint.z,
                                   pass.after,
                                   pass.at.x,
                                   pass.at.y);
  pass.seen.at[i] = seen[i];
}
