# The fail-loud fixture: nodes that get things wrong on purpose, which the views
# src/tools/tests/fail-loud.py writes put together. As a whole it runs only as far as
# its mistakes let it: draw writes a buffer, which a draw may not.

[manifest]
version = 1

# Fills values with its amount.
[node "fill"]
invocations = 64
param       = amount=1

# Fills values as fill does. Its C++ registers the operators the cases name, each wrong
# in its own way, so a case names the one it runs.
[node "wrong"]
invocations = 64
param       = amount=1

# Writes vec2 pairs, which a reader of floats must refuse.
[node "pairs"]
invocations = 64

[node "sum"]
invocations = 64

[node "draw"]
vertex_count = 3

# Registers the command wrong's Twin registers.
[node "twin"]
operator = Twin

# Reads back the frame block and its params, and stops when they differ from what the
# engine wrote.
[node "frame"]
operator    = Frame
invocations = 12
param       = tint=0.25,0.5,0.75
param       = after=1.5
param       = at=-2,4

# Stops unless the input command's events reach it in the frame after they were made.
[node "input"]
operator = Input

# Hands take the frame it cooks in, through a connection between C++ nodes; its C++
# also registers an operator whose output no other node can name.
[node "give"]
operator = Give

# Stops unless what give handed it was written that frame; its C++ also registers an
# operator that reads it as another type.
[node "take"]
operator = Take

# Writes structs its shader sums, and stops when the sums differ from what their
# members make; its C++ also registers one whose struct puts two members elsewhere.
[node "shape"]
operator    = Shapes
invocations = 4

# Fills the shapes shape's shader sums, through a connection, with no shader of its own;
# its C++ also registers operators whose struct puts two members elsewhere, and that give
# no room.
[node "maker"]
operator = Maker

# Makes a buffer through the engine by hand.
[node "scratch"]
operator = Scratch

# Fills an image once, and stops when its shader samples other pixels than it filled;
# its C++ also registers operators that fill one through a connection, fill one of
# 16-bit floats, fill one again after image clear, fill one nothing samples, and upload
# the wrong count of pixels.
[node "picture"]
operator    = Picture
invocations = 8
image       = picture=R8_UNORM

# Writes the Rects and Labels of a sign, which the library's rects and glyphs draw.
[node "sign"]
operator = Sign

# Draws each pixel's place into an image, which look samples in the same frame.
[node "paint"]
vertex_count = 3

# Stores each pixel's place into an image, which look samples in the same frame.
[node "stamp"]
invocations = 64

# A vertex node, which hands each pixel's place to ink, its fragment node, as varyings.
[node "brush"]
vertex_count = 3

[node "ink"]

# Fragment nodes that take brush's varyings at other types and locations, or declare a
# pass block, which a fragment node may not.
[node "smudge"]

[node "blot"]

# Stores into an image from a draw, which only a dispatch may.
[node "smear"]
vertex_count = 3

# Draws with a .frag that reads a varying its .vert writes nothing to.
[node "rub"]
vertex_count = 3

# Stops when a pixel of paint's image reads back as another; its C++ also registers
# operators that check scene's pattern, in the window of a view its view hosts, and the
# pixels stamp stores.
[node "look"]
operator    = Look
invocations = 64

# Draws blocks into its view's window, red flipping every frame, which the view hosting it
# takes, for look to sample.
[node "scene"]
vertex_count = 6

[connection "values"]
from = fill.values
to   = sum.values

[connection "count"]
from = give.count
to   = take.count

[connection "painted"]
from = paint.color
to   = look.painted
