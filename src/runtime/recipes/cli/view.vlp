# The CLI app: a command-line on the terminal, and no window, so everything a GUI does
# can be typed or scripted headless. Each node inside cli uses a part as it is (V11).
[manifest]
version = 1

[node "cli"]

[node "cli.command-line"]
recipe = command-line

# ls lists where the ide's graph is, while the ide runs: the folder it shows, or the
# inside of the node it shows.
[node "cli.inspect"]
recipe = inspect
param  = graph=ide:ide.graph.graph
param  = folders=ide:ide.graph.relations

[node "cli.library"]
recipe = library

[node "cli.projects"]
recipe = projects

# open starts the person's editor, or, while the ide runs, gives a file to its editor, a
# folder to its graph, through the relations part the graph shows a folder from, and an
# image file to its Perform panel, as a preview.
[node "cli.editor"]
recipe = editor
param  = window=ide:ide.editor.text
param  = folders=ide:ide.graph.relations
param  = images=ide:ide.preview-file
