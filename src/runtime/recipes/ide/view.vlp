# The IDE app: Vulpen editing Vulpen, a window the cli hosts beside the projects, so every
# command that reads or changes a view is the cli's, and this adds what the window
# shows: ./run.sh --ide. Only child recipes and the wires between them, built by
# addition: each row is recipes placed side by side and connected, never a bigger recipe
# with nodes removed. Built so far: Look, Keys, Modes, the menubar along the window's
# top, a button a panel and the run's, the dock below it, with the editor in its top row
# beside the graph over the Perform panel, and the terminal in its bottom row, and the
# menus a right press opens in the graph.
#
#   Look       palette + font         one theme and one atlas for every drawing part
#   Keys       keys                   keymap chords to commands, other keys to the focus
#   Dock       viewport + dock        seats the menubar and the panels in the window
#   Editor     panel + text-area + find-bar
#   Terminal   panel + terminal
#   Graph      panel + graph-editor
#   Perform    panel + switch + switch-tabs + image ×2 + image-file
#                                     the window of the view presented, or a preview
#   Menubar    panel + join           a button a panel and the run's, along the top
#   Menu       menu                   the menus of menu.ini, at a right press in the graph
#   Tooltip    tooltip
#   Modes      modes + image          edit or perform: the dock, or the view presented
[manifest]
version = 1

[node "ide"]

[node "ide.palette"]
recipe = palette

[node "ide.font"]
recipe = font

# The terminal has the focus at first, so a line can be typed before anything is pressed.
[node "ide.keys"]
recipe = keys
param  = focus=ide.terminal.command-line

[node "ide.viewport"]
recipe = viewport

# Edit mode gives the dock the window, and perform mode the view presented. present
# connects the window of a project beside the ide to the Perform panel's image and the
# one that fills the window; each project loaded is presented as it comes, the Perform
# panel showing again if it was hidden, with the view presented in place of a preview,
# and the others draw nowhere and keep running.
[node "ide.modes"]
recipe = modes
param  = to=ide.presented.picture,ide.screen.picture
param  = shows=ide.perform-panel
param  = switch=ide.perform

# The window's top: a button a panel, lit while it shows, whose press hides it or brings
# it back, then the run's, edit, perform and gpu, as a panel's tabs; it hands the rest to
# the dock, past a seam, the divider the docking part draws, which a drag hides the
# menubar by and shows it again.
[node "ide.menubar"]
recipe = panel
param  = bar.seam=yes

[node "ide.buttons"]
recipe = join

# Listed before the panels it seats, so its ground is drawn first.
[node "ide.dock"]
recipe = dock
param  = split.axis=y
param  = split.ratio=0.65

# The dock's top row: the editor, and beside it the graph over the Perform panel.
[node "ide.top"]
recipe = dock
param  = split.axis=x
param  = split.ratio=0.5

[node "ide.side"]
recipe = dock
param  = split.axis=y
param  = split.ratio=0.5

# Each content is listed before its panel, so the panel's strip draws over it, as a
# tab's name cut short shows whole below the tab, over the content.
# Over the editor, a row to find in it, which control+f in the editor opens.
[node "ide.editor-find"]
recipe = find-bar
param  = command-line.host=ide.editor.text

[node "ide.editor"]
recipe = text-area

[node "ide.editor-panel"]
recipe = panel

# The graph of the view the terminal's lines go to, under a tab naming it.
[node "ide.graph"]
recipe = graph-editor
param  = graph.shows=ide.editor-panel

[node "ide.graph-panel"]
recipe = panel

# The Perform panel's room goes to the view presented, or while an image file is open,
# to its preview, as a switch hands it one half, under one strip of the two's tabs.
[node "ide.perform"]
recipe = switch

[node "ide.perform-tabs"]
recipe = switch-tabs

# A drag moves the view presented and the wheel zooms it, as in the graph, and h, while
# the panel has the focus, brings it home; the window that fills the whole window in
# perform mode stays still.
[node "ide.presented"]
recipe = image
param  = moves=yes

# An image file open opens, as a preview: it shows in the Perform panel in place of the
# view presented, never in perform mode, under a tab of its own, whose close mark closes
# it, the view presented showing again.
[node "ide.preview-file"]
recipe = image-file
param  = switch=ide.perform

[node "ide.preview"]
recipe = image
param  = moves=yes

# A tab a project, whose press makes it the current view; the panel shows the one
# presented.
[node "ide.perform-panel"]
recipe = panel

[node "ide.terminal"]
recipe = terminal

[node "ide.terminal-panel"]
recipe = panel

# A panel's tab strip dragged onto another panel moves it to that panel's edge it is let
# go nearest, as edits of the docks, which a save of the ide keeps. Listed after the
# panels and before what draws over them, so a panel a drag adds goes before it.
[node "ide.docking"]
recipe = docking

# The menus of menu.ini, which a right press in the graph opens there; listed after the
# panels, so they drop over them. An item types its line into the terminal's.
[node "ide.menu"]
recipe = menu
param  = menus.line=ide.terminal.command-line

[node "ide.docking-rects"]
recipe = rects

# A close mark at the end of each panel's strip, which hides the panel.
[node "ide.docking-glyphs"]
recipe = glyphs

# What is presented, over the whole window in perform mode; in edit mode it has no room.
[node "ide.screen"]
recipe = image

[connection "viewport"]
from = ide.viewport.area
to   = ide.modes.area

[connection "edit"]
from = ide.modes.edit
to   = ide.menubar.bar.area

# The outermost dock's Rect, from which docking finds where every panel shows.
[connection "dock"]
from = ide.menubar.bar.rest
to   = ide.dock.split.area
to   = ide.docking.area

[connection "panel-buttons"]
from = ide.docking.buttons
to   = ide.buttons.first

[connection "run-buttons"]
from = ide.modes.buttons
to   = ide.buttons.second

[connection "buttons"]
from = ide.buttons.items
to   = ide.menubar.tabs.items
to   = ide.menubar.hit.items

[connection "docking"]
from = ide.docking.rects
to   = ide.docking-rects.rects

[connection "docking-labels"]
from = ide.docking.labels
to   = ide.docking-glyphs.labels

[connection "docking-characters"]
from = ide.docking.characters
to   = ide.docking-glyphs.characters

# The editors, by which the docking part moves the file an editor holding several shows
# into another editor, rather than the editor's panel.
[connection "editors"]
from = ide.editor.text.editors
to   = ide.docking.editors

[connection "perform"]
from = ide.modes.perform
to   = ide.screen.area

[connection "top"]
from = ide.dock.split.first
to   = ide.top.split.area

[connection "editor-panel"]
from = ide.top.split.first
to   = ide.editor-panel.bar.area

[connection "editor-area"]
from = ide.editor-panel.bar.rest
to   = ide.editor-find.command-line.area

# What the find bar leaves the editor, all of it while it is closed.
[connection "editor-rest"]
from = ide.editor-find.command-line.rest
to   = ide.editor.text.area

# A tab a file open; a press on one shows it.
[connection "editor-tabs"]
from = ide.editor.text.tabs
to   = ide.editor-panel.tabs.items
to   = ide.editor-panel.hit.items

[connection "side"]
from = ide.top.split.second
to   = ide.side.split.area

[connection "graph-panel"]
from = ide.side.split.first
to   = ide.graph-panel.bar.area

# The graph's room, where a right press opens the menus too.
[connection "graph-area"]
from = ide.graph-panel.bar.rest
to   = ide.graph.bar.area
to   = ide.menu.menus.area

[connection "graph-tabs"]
from = ide.graph.graph.tabs
to   = ide.graph-panel.tabs.items
to   = ide.graph-panel.hit.items

[connection "perform-panel"]
from = ide.side.split.second
to   = ide.perform-panel.bar.area

[connection "perform-area"]
from = ide.perform-panel.bar.rest
to   = ide.perform.area

# The first half's room goes to the tabs too, by which they find the switch.
[connection "perform-shown"]
from = ide.perform.first
to   = ide.presented.area
to   = ide.perform-tabs.first

[connection "preview-shown"]
from = ide.perform.second
to   = ide.preview.area

[connection "preview"]
from = ide.preview-file.picture
to   = ide.preview.picture

[connection "perform-tabs"]
from = ide.modes.tabs
to   = ide.perform-tabs.first-tabs

[connection "preview-tabs"]
from = ide.preview-file.tabs
to   = ide.perform-tabs.second-tabs

[connection "perform-panel-tabs"]
from = ide.perform-tabs.tabs
to   = ide.perform-panel.tabs.items
to   = ide.perform-panel.hit.items

[connection "terminal-panel"]
from = ide.dock.split.second
to   = ide.terminal-panel.bar.area

[connection "terminal-area"]
from = ide.terminal-panel.bar.rest
to   = ide.terminal.command-line.area

[connection "terminal-tabs"]
from = ide.terminal.command-line.tabs
to   = ide.terminal-panel.tabs.items
to   = ide.terminal-panel.hit.items

# The keys no chord takes, for the part in focus; those no part in focus takes go to modes.
[connection "typed"]
from = ide.keys.typed
to   = ide.editor.text.typed
to   = ide.editor-find.command-line.typed
to   = ide.terminal.command-line.typed
to   = ide.graph.graph.typed
to   = ide.presented.typed
to   = ide.preview.typed
to   = ide.modes.typed
to   = ide.menu.menus.typed

[connection "palette"]
from = ide.palette.palette
to   = ide.dock.rects.palette
to   = ide.top.rects.palette
to   = ide.side.rects.palette
to   = ide.editor-panel.rects.palette
to   = ide.editor-panel.glyphs.palette
to   = ide.editor.rects.palette
to   = ide.editor.glyphs.palette
to   = ide.editor-find.rects.palette
to   = ide.editor-find.glyphs.palette
to   = ide.graph-panel.rects.palette
to   = ide.graph-panel.glyphs.palette
to   = ide.graph.graph.palette
to   = ide.graph.curves.palette
to   = ide.graph.rects.palette
to   = ide.graph.glyphs.palette
to   = ide.graph.button-rects.palette
to   = ide.graph.button-glyphs.palette
to   = ide.graph.tip.rects.palette
to   = ide.graph.tip.glyphs.palette
to   = ide.perform-panel.rects.palette
to   = ide.perform-panel.glyphs.palette
to   = ide.terminal-panel.rects.palette
to   = ide.terminal-panel.glyphs.palette
to   = ide.terminal.rects.palette
to   = ide.terminal.glyphs.palette
to   = ide.menubar.rects.palette
to   = ide.menubar.glyphs.palette
to   = ide.menu.names-rects.palette
to   = ide.menu.names-glyphs.palette
to   = ide.menu.items-rects.palette
to   = ide.menu.items-glyphs.palette
to   = ide.docking-rects.palette
to   = ide.docking-glyphs.palette

[connection "font"]
from = ide.font.font
to   = ide.editor-panel.glyphs.font
to   = ide.editor.glyphs.font
to   = ide.editor-find.glyphs.font
to   = ide.graph-panel.glyphs.font
to   = ide.graph.glyphs.font
to   = ide.graph.button-glyphs.font
to   = ide.graph.tip.glyphs.font
to   = ide.perform-panel.glyphs.font
to   = ide.terminal-panel.glyphs.font
to   = ide.terminal.glyphs.font
to   = ide.menubar.glyphs.font
to   = ide.menu.names-glyphs.font
to   = ide.menu.items-glyphs.font
to   = ide.docking-glyphs.font

[connection "atlas"]
from = ide.font.atlas
to   = ide.editor-panel.glyphs.atlas
to   = ide.editor.glyphs.atlas
to   = ide.editor-find.glyphs.atlas
to   = ide.graph-panel.glyphs.atlas
to   = ide.graph.glyphs.atlas
to   = ide.graph.button-glyphs.atlas
to   = ide.graph.tip.glyphs.atlas
to   = ide.perform-panel.glyphs.atlas
to   = ide.terminal-panel.glyphs.atlas
to   = ide.terminal.glyphs.atlas
to   = ide.menubar.glyphs.atlas
to   = ide.menu.names-glyphs.atlas
to   = ide.menu.items-glyphs.atlas
to   = ide.docking-glyphs.atlas

[connection "metrics"]
from = ide.font.metrics
to   = ide.editor-panel.bar.font
to   = ide.editor-panel.tabs.font
to   = ide.editor.text.font
to   = ide.editor-find.command-line.font
to   = ide.graph-panel.bar.font
to   = ide.graph-panel.tabs.font
to   = ide.graph.bar.font
to   = ide.graph.graph.font
to   = ide.graph.buttons.font
to   = ide.graph.tip.list.font
to   = ide.perform-panel.bar.font
to   = ide.perform-panel.tabs.font
to   = ide.terminal-panel.bar.font
to   = ide.terminal-panel.tabs.font
to   = ide.terminal.command-line.font
to   = ide.menubar.bar.font
to   = ide.menubar.tabs.font
to   = ide.menu.names.font
to   = ide.menu.items.font
to   = ide.docking.font
