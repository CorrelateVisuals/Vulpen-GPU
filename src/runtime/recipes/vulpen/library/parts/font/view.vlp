# The font part: one node whose operator is Font; it bakes the font file its face param
# names, in its folder, into an atlas, a cell a glyph as wide as the widest, at the
# height its param gives in pixels, and hands the parts that lay text out its metrics:
# the Font and each glyph's advance, so a proportional face lays out as it is drawn. To bake another face, put its file in the folder and name it; two
# faces or heights at once are two font nodes.
[manifest]
version = 1

[node "font"]
param = face=RobotoMono-Regular.ttf
param = height=18
image = atlas=R8_UNORM
