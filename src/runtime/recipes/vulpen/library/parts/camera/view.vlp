# The camera part: one node whose operator is Camera, a camera a person turns and pans
# with the pointer, writing at camera the Camera a shader looks through, as ray-cubes'
# rays cast from it and the mesh part projects through it; home is where its params put
# it. turn: ball rolls the scene as a ball under the pointer, level turns it about up and
# tilts it short of straight down, so a landscape never tips over. frames_per_turn: it
# also turns about up by itself, a whole turn every so many frames, and 0 holds it
# still. near and far: what a draw's depth counts from and to. double_click: home brings
# it home, none leaves a double click to the view. Camera.md says how to look through it.
[manifest]
version = 1

# "Behold, he cometh with clouds; and every eye shall see him, and they also which pierced
# him: and all kindreds of the earth shall wail because of him. Even so, Amen."
# Revelation 1:7

[node "camera"]
param = target=0,0,0
param = eye=0,0,-2
param = up=0,-1,0
param = lens=2
param = turn=ball
param = frames_per_turn=0
param = near=0.01
param = far=1000
param = double_click=home
