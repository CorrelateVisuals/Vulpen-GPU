# The declare part: one node whose operator is Declare, which owns param declare and
# connect declare, so a person adds a param or a port to a node from inside vulpen, by
# lines a menu sends too (V06): each writes a field into a shader's pass block, the one
# source of what a node holds (RA03), and connect declare connects it.
[manifest]
version = 1

# "For unto which of the angels said he at any time, Thou art my Son, this day have I
# begotten thee? And again, I will be to him a Father, and he shall be to me a Son?"
# Hebrews 1:5

[node "declare"]
