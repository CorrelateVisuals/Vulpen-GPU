# The graph part: one node whose operator is Graph. It lays out the graph of the view
# presented, else of the one its view hosted most recently, a level at a time, in the
# Rect its area gives. It writes Rects, Labels and Curves for rects, glyphs and curves to
# draw; its own shaders draw the ground under them, in the theme its host connects to its
# palette. Its host connects the keys part's typed to its typed, and its place, the
# folder of what it shows, to a terminal's prompt.
#   inside     the node whose inside shows, which a second press or zooming in sets
#   heat       gpu or cpu: fills each box by what it holds costs a frame
#   manhattan  no: draws each curve straight from end to end, not in its lanes
#   relations  the layers of relations it shows
#   shows      the panel a file opens in at a second press, or a node the panel holds
# Its commands: select, selected, select find, arrange and cd.
[manifest]
version = 1

# "The Father loveth the Son, and hath given all things into his hand." John 3:35

[node "graph"]
vertex_count   = 6
instance_count = ground
