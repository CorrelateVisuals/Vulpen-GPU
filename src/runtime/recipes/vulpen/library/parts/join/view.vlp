# The join part: one node whose operator is Join; it hands on as items the Items its
# first and its second give, the first's then the second's, as one row of buttons.
[manifest]
version = 1

# "That in the dispensation of the fulness of times he might gather together in one all
# things in Christ, both which are in heaven, and which are on earth; even in him:"
# Ephesians 1:10

[node "join"]
