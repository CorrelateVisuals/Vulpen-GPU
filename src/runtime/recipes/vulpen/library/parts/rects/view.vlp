# The rects part: one shader node with no C++; it draws every Rect it is given in its
# palette color, or between two, a quad an instance, as many as the Rects' writer wrote.
[manifest]
version = 1

# "And the city lieth foursquare, and the length is as large as the breadth: and he
# measured the city with the reed, twelve thousand furlongs. The length and the breadth
# and the height of it are equal." Revelation 21:16

[node "rects"]
vertex_count   = 6
instance_count = rects
