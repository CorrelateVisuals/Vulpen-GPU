# The switch part: one node whose operator is Switch; it hands the Rect its area gives to
# first or second, the half its shown param names, and none to the other.
[manifest]
version = 1

# "This beginning of miracles did Jesus in Cana of Galilee, and manifested forth his
# glory; and his disciples believed on him." John 2:11

[node "switch"]
param = shown=first
