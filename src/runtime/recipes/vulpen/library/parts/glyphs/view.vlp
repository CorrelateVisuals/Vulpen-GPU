# The glyphs part: one shader node with no C++; it lays out every Label in the font, each
# character at the x its writer measured, and draws it, a quad a character, as many as
# the characters' writer wrote.
[manifest]
version = 1

# "And when I saw him, I fell at his feet as dead. And he laid his right hand upon me,
# saying unto me, Fear not; I am the first and the last:" Revelation 1:17

[node "glyphs"]
vertex_count   = 6
instance_count = characters
