# The projects part: one node whose operator is Projects. Its folder param names where the
# projects are, from this folder: projects/ at the top of the repository; its apps param
# where the apps are, beside the library, whose name view load also takes.
[manifest]
version = 1

# "To him the porter openeth; and the sheep hear his voice: and he calleth his own sheep
# by name, and leadeth them out." John 10:3

[node "projects"]
param = folder=../../../../../../../projects
param = apps=../../..
