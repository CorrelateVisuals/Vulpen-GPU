# The files part: one node whose operator is Files, which owns new, rename, copy and
# remove, so a person makes, moves and deletes files and folders from inside vulpen, and
# in a project its nodes, which are its folders.
[manifest]
version = 1

# "Him that overcometh will I make a pillar in the temple of my God, and he shall go no
# more out: and I will write upon him the name of my God, and the name of the city of my
# God, which is new Jerusalem, which cometh down out of heaven from my God: and I will
# write upon him my new name." Revelation 3:12

[node "files"]

# What new starts a file with, by its extension: the least that builds and runs. Their
# files end in .in, so they build only once new writes them.
[node "files.start"]
