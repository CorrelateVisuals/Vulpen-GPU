// How finely the draw cuts each triangle the .vert hands on, a patch of its three
// corners, into smaller ones, for the .tese to place: so many parts along each edge and
// across the inside.
//
// Each way data reaches here is commented out: uncomment what you use and delete the
// rest; a pass block field nothing fills is refused. A node's shaders share one pass
// block: declare it in the shader that reads it, or for all in a file they #include.
#include "baseclasses/GpuLayout.glsl" // the pass block's types, and frame.time
// layout(set = 1, binding = 0) uniform Pass {
//   float level; // from you, no C++: node set <node> param=level=4
// } pass;
layout(vertices = 3) out;

// From the .vert, one a corner, at the location and type it writes, on to the .tese.
// layout(location = 0) in vec3 color[];
// layout(location = 0) out vec3 colors[];

void main() {
  gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
  // colors[gl_InvocationID] = color[gl_InvocationID];
  float level = 16.0;
  // level = pass.level;
  // level *= 1.5 + sin(frame.time); // finer and coarser as time goes
  gl_TessLevelOuter[0] = level;
  gl_TessLevelOuter[1] = level;
  gl_TessLevelOuter[2] = level;
  gl_TessLevelInner[0] = level;
}
