// How finely the draw cuts each triangle the .vert hands on, a patch of its three
// corners, into smaller ones, for the .tese to place: so many parts along each edge and
// across the inside.
//
// Each way data reaches here is commented out, its lines numbered alike in every file of
// the node. To use one, uncomment its lines here and in the stages around, with the
// block's first and last lines, and delete the rest. A draw's stages share one pass
// block: declare it in one of them, or in a file they all #include. Examples:
// [1] triangle-params, [8] triangle-compute.
#include "baseclasses/GpuLayout.glsl" // the pass block's types, and frame.time
// layout(set = 1, binding = 0) uniform Pass {
//   float level; // [1] from you: param set <node> level 4
// } pass;
layout(vertices = 3) out;

// From the .vert, one a corner, at the location and type it writes, on to the .tese.
layout(location = 0) in vec3 color[];
layout(location = 0) out vec3 colors[];
// layout(location = 1) in vec2 uv[];   // [8]
// layout(location = 1) out vec2 uvs[]; // [8]

// "Now are we sure that thou knowest all things, and needest not that any man should ask
// thee: by this we believe that thou camest forth from God." John 16:30

void main() {
  gl_out[gl_InvocationID].gl_Position = gl_in[gl_InvocationID].gl_Position;
  colors[gl_InvocationID] = color[gl_InvocationID];
  // uvs[gl_InvocationID] = uv[gl_InvocationID]; // [8]
  float level = 16.0;
  // level = pass.level; // [1]
  // level *= 1.5 + sin(frame.time); // finer and coarser as time goes
  gl_TessLevelOuter[0] = level;
  gl_TessLevelOuter[1] = level;
  gl_TessLevelOuter[2] = level;
  gl_TessLevelInner[0] = level;
}
