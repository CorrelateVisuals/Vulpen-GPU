// Where each of node <node>'s vertex_count vertices goes, a triangle in the middle, and
// a color a corner, which the GPU blends across the face on its way to the .frag.
//
// Each way data reaches here is commented out, its lines numbered alike in every file of
// the node. To use one, uncomment its lines here and in Name.cpp or the next stage, with
// the block's first and last lines, and delete the rest. A draw's stages share one pass
// block: declare it in one of them, or in a file they all #include. Examples:
// [1] triangle-params, [2] wave, [3] triangle, [8] triangle-compute.
#include "baseclasses/GpuLayout.glsl" // the pass block's types, and frame.time
// VP_READS(Vec4sIn, vec4); // [3]
// layout(set = 1, binding = 0) uniform Pass {
//   float scale;    // [1] from you: param set <node> scale 0.5
//   float phase;    // [2] from Name.cpp, each frame
//   Vec4sIn points; // [3] from Name.cpp, one a vertex
// } pass;
const vec2 corners[3] = vec2[](vec2(0.0, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));
const vec3 colors[3] =
    vec3[](vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0));

// To the .frag, or a .tesc or .geom before it, which reads each at the same location
// and type.
layout(location = 0) out vec3 color;
// layout(location = 1) out vec2 uv; // [8]

void main() {
  gl_Position = vec4(corners[gl_VertexIndex % 3], 0.0, 1.0);
  // gl_Position.xy *= pass.scale;                        // [1]
  // gl_Position.x += 0.25 * sin(pass.phase);             // [2] sways as C++'s phase goes
  // gl_Position.xy += pass.points.at[gl_VertexIndex].xy; // [3] where C++ moved it
  color = colors[gl_VertexIndex % 3];
  // uv = corners[gl_VertexIndex % 3] + 0.5;              // [8]
}
