// The color of each pixel the draw covers: the corners' colors, blended across the face.
//
// Each way data reaches here is commented out, its lines numbered alike in every file of
// the node. To use one, uncomment its lines here and in Name.cpp or the stage before,
// with the block's first and last lines, and delete the rest. A draw's stages share one
// pass block: declare it in one of them, or in a file they all #include. Examples:
// [1] triangle-params, [6] [8] triangle-compute.
#include "baseclasses/GpuLayout.glsl" // the pass block's types, sample_linear
// layout(set = 1, binding = 0) uniform Pass {
//   float tint;      // [1] from you: param set <node> tint 0.5
//   Texture picture; // [6] from Name.cpp, or: connect <writer>.canvas <node>.picture
// } pass;

// From the .vert, or a .tese or .geom after it, each at the location and type it writes.
layout(location = 0) in vec3 color;
// layout(location = 1) in vec2 uv; // [8]

// The draw's picture: the window's, or, once a connection starts at <node>.pixel, an
// image another node samples. A .frag writes no buffer: a .comp that samples the image
// hands what it sees back to C++, as [5].
layout(location = 0) out vec4 pixel;

// "In him was life; and the life was the light of men." John 1:4

void main() {
  pixel = vec4(color, 1.0);
  // pixel.rgb *= pass.tint;                  // [1]
  // pixel = sample_linear(pass.picture, uv); // [6] [8]
}
