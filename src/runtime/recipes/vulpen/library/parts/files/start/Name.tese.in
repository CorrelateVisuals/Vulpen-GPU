// Where each point the .tesc cut the triangle into goes: among the patch's three corners,
// as near each as gl_TessCoord says, waving with frame.time; its color the corners',
// blended as near, so the triangle keeps the .vert's colors as its edges wave.
//
// Each way data reaches here is commented out, its lines numbered alike in every file of
// the node. To use one, uncomment its lines here and in the stages around, with the
// block's first and last lines, and delete the rest. A draw's stages share one pass
// block: declare it in one of them, or in a file they all #include. Examples:
// [1] triangle-params, [8] triangle-compute.
#include "baseclasses/GpuLayout.glsl" // the pass block's types, and frame.time
// layout(set = 1, binding = 0) uniform Pass {
//   float height; // [1] from you: param set <node> height 0.1
// } pass;
layout(triangles, equal_spacing, ccw) in;

// From the .tesc, one a corner, at the location and type it writes.
layout(location = 0) in vec3 colors[];
// layout(location = 1) in vec2 uvs[]; // [8]

// To the .frag, or a .geom, which reads it at the same location and type.
layout(location = 0) out vec3 color;
// layout(location = 1) out vec2 uv; // [8]

// "For where two or three are gathered together in my name, there am I in the midst of
// them." Matthew 18:20

void main() {
  const vec3 near = gl_TessCoord; // to each corner, together 1
  gl_Position = near.x * gl_in[0].gl_Position + near.y * gl_in[1].gl_Position +
                near.z * gl_in[2].gl_Position;
  gl_Position.y += 0.05 * sin(12.0 * gl_Position.x + 3.0 * frame.time);
  // gl_Position.y += pass.height * sin(12.0 * gl_Position.x); // [1]
  color = near.x * colors[0] + near.y * colors[1] + near.z * colors[2];
  // uv = near.x * uvs[0] + near.y * uvs[1] + near.z * uvs[2]; // [8]
}
