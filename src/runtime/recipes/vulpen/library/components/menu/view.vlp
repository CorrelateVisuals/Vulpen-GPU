# The menu component: three columns of list, hit, rects and glyphs, which drop as a menu
# does: the first below where its host's menus part says it opened, at its at, and the
# words after the word the pointer is on in the next column, beside it, each column's
# words those the menus part hands it as first, second and third. Its host lists the
# menus part apart, ahead of the node that reads the lines it hands, and this after what
# it drops over, so it draws over it; and connects the menus part's at to menu.first's
# place, its first, second and third to each column's list and hit's items, the font's
# metrics to each column's list, the theme to the rects and the glyphs, and the font and
# its atlas to the glyphs. Its hits send a word's press as it is, so it reaches the menus
# in the frame the press shuts them, and the terminal shows only the line it ends.
[manifest]
version = 1

[node "menu"]

[node "menu.first"]
recipe = list
param  = drop=below

[node "menu.first-hit"]
recipe = hit
param  = typed=no

[node "menu.first-rects"]
recipe = rects

[node "menu.first-glyphs"]
recipe = glyphs

[node "menu.second"]
recipe = list
param  = drop=right

[node "menu.second-hit"]
recipe = hit
param  = typed=no

[node "menu.second-rects"]
recipe = rects

[node "menu.second-glyphs"]
recipe = glyphs

[node "menu.third"]
recipe = list
param  = drop=right

[node "menu.third-hit"]
recipe = hit
param  = typed=no

[node "menu.third-rects"]
recipe = rects

[node "menu.third-glyphs"]
recipe = glyphs

[connection "first-shown"]
from = menu.first.shown
to   = menu.first-hit.rects

[connection "first-marks"]
from = menu.first.marks
to   = menu.first-hit.marks

[connection "first-rects"]
from = menu.first.rects
to   = menu.first-rects.rects

[connection "first-labels"]
from = menu.first.labels
to   = menu.first-glyphs.labels

[connection "first-characters"]
from = menu.first.characters
to   = menu.first-glyphs.characters

# The word open in each column, which the next column opens beside.
[connection "first-open"]
from = menu.first.current
to   = menu.second.place

[connection "second-shown"]
from = menu.second.shown
to   = menu.second-hit.rects

[connection "second-marks"]
from = menu.second.marks
to   = menu.second-hit.marks

[connection "second-rects"]
from = menu.second.rects
to   = menu.second-rects.rects

[connection "second-labels"]
from = menu.second.labels
to   = menu.second-glyphs.labels

[connection "second-characters"]
from = menu.second.characters
to   = menu.second-glyphs.characters

[connection "second-open"]
from = menu.second.current
to   = menu.third.place

[connection "third-shown"]
from = menu.third.shown
to   = menu.third-hit.rects

[connection "third-marks"]
from = menu.third.marks
to   = menu.third-hit.marks

[connection "third-rects"]
from = menu.third.rects
to   = menu.third-rects.rects

[connection "third-labels"]
from = menu.third.labels
to   = menu.third-glyphs.labels

[connection "third-characters"]
from = menu.third.characters
to   = menu.third-glyphs.characters
