# The menu component: menus, list, hit, rects and glyphs. A right press in the Rect its
# host connects to menus.area drops a column of names there, a menu each, as menu.ini
# gives them, over what lies there, which takes no press while it shows; the pointer on
# a name opens that menu's items beside it, and a press on an item sends its line, typed
# into the node the menus' line param names, until a press anywhere or escape shuts it.
# Its host connects the keys part's typed to menus.typed, the font's metrics to
# names.font and items.font, the theme to the rects and the glyphs, and the font and its
# atlas to the glyphs, and lists it after what it drops over, so it draws over it.
[manifest]
version = 1

[node "menu"]

[node "menu.menus"]
recipe = menus

[node "menu.names"]
recipe = list
param  = drop=below

# The pointer on a name opens its menu, so the open menu follows it along the names.
[node "menu.names-hit"]
recipe = hit
param  = hover=yes

[node "menu.names-rects"]
recipe = rects

[node "menu.names-glyphs"]
recipe = glyphs

[node "menu.items"]
recipe = list
param  = drop=right

[node "menu.items-hit"]
recipe = hit

[node "menu.items-rects"]
recipe = rects

[node "menu.items-glyphs"]
recipe = glyphs

# Where the menus were opened, which the names drop below.
[connection "at"]
from = menu.menus.at
to   = menu.names.place

[connection "names"]
from = menu.menus.names
to   = menu.names.items
to   = menu.names-hit.items

[connection "names-shown"]
from = menu.names.shown
to   = menu.names-hit.rects

[connection "names-marks"]
from = menu.names.marks
to   = menu.names-hit.marks

[connection "names-rects"]
from = menu.names.rects
to   = menu.names-rects.rects

[connection "names-labels"]
from = menu.names.labels
to   = menu.names-glyphs.labels

[connection "names-characters"]
from = menu.names.characters
to   = menu.names-glyphs.characters

# The open menu's name, which its items drop below.
[connection "open"]
from = menu.names.current
to   = menu.items.place

[connection "items"]
from = menu.menus.items
to   = menu.items.items
to   = menu.items-hit.items

[connection "items-shown"]
from = menu.items.shown
to   = menu.items-hit.rects

[connection "items-marks"]
from = menu.items.marks
to   = menu.items-hit.marks

[connection "items-rects"]
from = menu.items.rects
to   = menu.items-rects.rects

[connection "items-labels"]
from = menu.items.labels
to   = menu.items-glyphs.labels

[connection "items-characters"]
from = menu.items.characters
to   = menu.items-glyphs.characters
