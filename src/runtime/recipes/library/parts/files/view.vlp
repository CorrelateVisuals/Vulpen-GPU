# The files part: one node whose operator is Files, which owns new, file rename, file copy
# and file remove, so a person makes, moves and deletes files and folders from inside
# vulpen, and in a project its nodes, which are its folders.
[manifest]
version = 1

[node "files"]

# What new starts a file with, by its extension: the least that builds and runs. Their
# files end in .in, so they build only once new writes them.
[node "files.start"]
