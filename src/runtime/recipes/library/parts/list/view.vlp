# The list part: one node whose operator is List; it lays out the Items it is handed in
# the Rect its place gives, stacked or, with axis=x, side by side, or with drop=below or
# drop=right in a column below or right of its place, sized to them, for a rects and a
# glyphs node to draw, and hands
# on where each shows as shown, and where an Item's close mark shows as marks, for hit to
# find the one pressed, and where the current one shows as current.
[manifest]
version = 1

[node "list"]
operator = List
file     = List.cpp
param    = axis=y
param    = drop=no
