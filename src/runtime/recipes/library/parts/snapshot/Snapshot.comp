#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 64) in;

VP_WRITES(UintsOut, uint);

layout(set = 1, binding = 0) uniform Pass {
  Texture picture; // a connection: a hosted view's window, or an image a draw renders
  uint shoot;      // from its C++: 1 the frame it shoots, so the others write nothing
  UintsOut pixels; // read back by its C++: a pixel an invocation, row by row
} pass;

// As the window shows it: its sRGB bytes, over black, as the window presents it.
float encoded(float linear) {
  return linear <= 0.0031308 ? linear * 12.92 : 1.055 * pow(linear, 1.0 / 2.4) - 0.055;
}

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const uvec2 size = frame.resolution;
  if (pass.shoot == 0u || i >= size.x * size.y)
    return;
  const vec2 uv = (vec2(i % size.x, i / size.x) + 0.5) / vec2(size);
  const vec3 color = sample_nearest(pass.picture, uv).rgb;
  pass.pixels.at[i] =
      packUnorm4x8(vec4(encoded(color.r), encoded(color.g), encoded(color.b), 1.0));
}
