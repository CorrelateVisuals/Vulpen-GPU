#pragma once

#include "runtime/Operator.h"

// Only Name.cpp includes this header, so the class stays in the unnamed namespace, and
// two copies of the node in one binary never clash.
namespace {

// What the Name operator is for, in a line or two.
class Name final : public VP::Operator {
  // At load, and again after every swap of this folder's C++.
  void bind(VP::Bind &node) override;
  // Every frame, before the node's shaders run.
  void cook(VP::Cook &frame) override;
  // When a command the node registered runs.
  void command(VP::Call &call) override;

  VP::Value<float> _angle;
};

} // namespace
