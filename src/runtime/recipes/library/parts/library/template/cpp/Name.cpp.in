// A C++ node: C++ alone, no shader, so it runs on the CPU, each frame before the GPU
// does. node new cpp wrote it: a ring of points, turning, or the points its file lists,
// which it hands to another node's shader once a connection takes them there.
//
// Use: connect its points to a buffer of Points another node's shader reads, as a draw
// node new draw made, once that draw's own C++ writes them no more (delete its _points):
//   connect points <node>.points <draw>.points
// <node> points says what it hands on; param set <node> count 6 or frames_per_turn 0
// changes it as it runs. Name.txt in the node's folder, a point a line as x,y in clip
// space, takes the ring's place while it lists any, read again whenever it changes.
// Alter: cook is the work, once a frame; bind asks for what cook uses, by name, so the
// loader checks it before a frame runs (A02).
// Repeat: another buffer for a shader is another Upload<T>, asked for in bind once a
// connection takes it and written in cook; an image for another node's Texture a
// Texture<T>, node.texture and frame.upload, as the draw template fills its pattern; an
// object for another C++ node node.output<T>("name"), with T in contracts/, which that
// node includes and reads by node.input<T>("name"); another command a node.command in
// bind and an is() in command; another file a node.file and frame.files().text.
#include "runtime/Operator.h"
#include "runtime/View.h"

#include <algorithm>
#include <array>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <format>
#include <numbers>
#include <optional>
#include <span>
#include <string>
#include <string_view>

namespace {

// A point as the draw template's Name.glsl reads it, member for member: once a connection
// takes points to a shader, the loader holds it to that shader's struct by name, type and
// offset (RA03). Two vec4s, so std430 and C++ lay it out alike.
struct Point {
  glm::vec4 position{}; // xy: in clip space, y pointing down; z: a square's side there
  glm::vec4 color{};

  static constexpr auto members() {
    return std::array{VP_MEMBER(Point, position), VP_MEMBER(Point, color)};
  }
};

constexpr float turn = 2.0f * std::numbers::pi_v<float>; // radians in a whole turn
constexpr std::uint32_t most_points = 64; // room the points buffer has, whatever count asks
constexpr float ring = 0.5f;              // the points' circle, in clip space
constexpr float side = 0.15f;             // a square's side, where a draw makes squares
constexpr std::size_t shown = 4;          // points the node's command answers with

// How far a whole turn every frames_per_turn frames has come at a frame, counted from the
// frame index, so it never drifts; none while frames_per_turn is 0.
float angle_at(std::uint64_t frame, std::uint32_t frames_per_turn) {
  if (frames_per_turn == 0)
    return 0.0f;
  return turn * static_cast<float>(frame % frames_per_turn) /
         static_cast<float>(frames_per_turn);
}

// A color of the hue circle at an angle, so each point shows its own.
glm::vec4 hue(float at) {
  return {0.5f + 0.5f * std::cos(at),
          0.5f + 0.5f * std::cos(at - turn / 3.0f),
          0.5f + 0.5f * std::cos(at + turn / 3.0f),
          1.0f};
}

// The points a text lists, a line each as x,y, into the room given; how many. A line that
// is no point ends them, so a line half typed takes none after it.
std::size_t listed(std::string_view text, std::span<glm::vec2> into) {
  std::size_t count = 0;
  while (!text.empty() && count < into.size()) {
    const std::size_t end = text.find('\n');
    if (!VP::parse_param(text.substr(0, end), into[count]))
      break;
    ++count;
    text.remove_prefix(end == std::string_view::npos ? text.size() : end + 1);
  }
  return count;
}

// Whether a connection takes the node's port to another node, in the view as the node
// binds: a port asked for that no connection takes is a mistake (A02), so the node asks
// for it only then, and runs alone too.
bool wired(const VP::Bind &node, std::string_view port) {
  const std::string name = node.name();
  return std::ranges::any_of(node.view().connections, [&](const VP::Connection &connection) {
    return connection.from.node == name && connection.from.port == port;
  });
}

// Makes points on the CPU each frame and hands them on, once a connection takes them, to
// the shader of the node it reaches.
class Name final : public VP::Operator {
  // At load, and again after every swap of this folder's C++ and every edit of the view,
  // so a connection made or let go of reaches it: names in, handles out.
  void bind(VP::Bind &node) override {
    _frames_per_turn = node.param<std::uint32_t>("frames_per_turn");
    _count = std::min(node.param<std::uint32_t>("count"), most_points);
    _list = node.file("Name.txt");
    _points.reset();
    if (wired(node, "points"))
      _points = node.upload<Point>("points", most_points);
    _name = node.name();
    // Every view's commands share one port, so the command carries the node's own name.
    _show = node.command(std::format("{} points", _name.substr(_name.rfind('.') + 1)),
                         "answers with the first points the node hands on, or how to "
                         "connect them");
  }

  // Every frame, before any node's pass runs on the GPU.
  void cook(VP::Cook &frame) override {
    std::array<glm::vec2, most_points> places{};
    const std::size_t from_file = listed(frame.files().text(_list), places);
    const float angle = angle_at(frame.index(), _frames_per_turn);
    _made = from_file != 0 ? from_file : _count;
    for (std::size_t i = 0; i < _made; ++i) {
      const float at = angle + turn * static_cast<float>(i) / static_cast<float>(_made);
      const glm::vec2 place =
          from_file != 0 ? places[i] : ring * glm::vec2(std::cos(at), std::sin(at));
      _made_points[i] = {.position = glm::vec4(place, side, 0.0f), .color = hue(at)};
    }
    // The first _made, the buffer's used length, so a draw whose instance_count names
    // the port it reaches draws as many.
    if (_points)
      std::ranges::copy_n(_made_points.begin(),
                          static_cast<std::ptrdiff_t>(_made),
                          frame.write(*_points, _made).begin());
  }

  // When a command the node registered runs: typed, from a script, or sent by a node.
  void command(VP::Call &call) override {
    if (!call.is(_show))
      return;
    if (!_points)
      return call.reply(std::format("no connection takes its points yet: connect <name> "
                                    "{}.points <node>.<buffer>, a buffer of Points a "
                                    "shader reads",
                                    _name));
    std::string text = std::format("hands on {} points:", _made);
    for (std::size_t i = 0; i < std::min(_made, shown); ++i)
      text += std::format(" {:.2f},{:.2f}",
                          _made_points[i].position.x,
                          _made_points[i].position.y);
    call.reply(text);
  }

  std::uint32_t _frames_per_turn = 0;
  std::uint32_t _count = 0;
  VP::File _list;
  std::optional<VP::Upload<Point>> _points; // while a connection takes them
  std::string _name;
  VP::Command _show;
  std::array<Point, most_points> _made_points{};
  std::size_t _made = 0;
};

} // namespace

VP_OPERATOR(Name);
