// The pass block Name.vert and Name.frag share, which the loader finds the same in each.
//
// Use: each field is filled by its name before the draw runs, by a param of the node, by
// Name.cpp, or through a connection from another node.
// Alter: a field's type is its param's, or its Value<T>'s in Name.cpp; change both.
// Repeat: another value is a line here and a param of its name, or a Value<T> in
// Name.cpp; another buffer a VP_READS line for its element and a field; another image a
// Texture field. A struct another node writes too goes in contracts/, as both include it.
#include "baseclasses/GpuLayout.glsl"

// A point as Name.cpp writes it, member for member, which the loader holds to its own.
struct Point {
  vec4 position; // xy: its square's middle, in clip space, y pointing down; z: its side
  vec4 color;
};

VP_READS(Points, Point);

// Each field is filled before the draw runs, by its name: by a param, by Name.cpp, or
// through a connection; the loader refuses one that nothing fills (A02).
layout(set = 1, binding = 0) uniform Pass {
  vec3 tint;       // a param: red, green and blue
  float angle;     // set by Name.cpp every frame
  Points points;   // written by Name.cpp every frame, an instance a point
  Texture pattern; // filled by Name.cpp once
} pass;
