// A dispatch node's C++, the CPU half of a compute pass: node new dispatch wrote it with
// Name.comp. Each frame it turns a ring of points and writes them for the shader, which
// moves a value a point toward a pattern it samples, keeps the values, stores a point a
// pixel into an image and writes samples that C++ reads back a frame later.
//
// Use: keep what the node needs and delete the rest, a field of Name.comp together with
// its handle here, as the loader names whatever is left half joined (A02). <node>
// samples answers with what came back; param set <node> glide 0.5 or frames_per_turn 0
// changes it as it runs; node set <node> invocations=128 runs more points, a multiple of
// local_size_x.
// Alter: to read a buffer another node writes, delete _points here, in bind, cook and the
// members, and connect that node's buffer to <node>.points; to hand samples or values on,
// connect them to a buffer another node's shader reads. To compute with no C++ at all,
// delete this file, make angle a param, and connect points and pattern.
// Repeat: another value is a field in Name.comp and a Value<T> here, bound in bind and
// set in cook, as angle; another buffer C++ writes a VP_READS line, a field and an
// Upload<T>, as points; one C++ reads back a VP_WRITES line, a field and a Readback<T>,
// as samples; another image C++ fills a Texture field and a Texture<T>, as pattern;
// another command a node.command in bind and an is() in command. Another compute pass is
// another node, node new dispatch <name>, its buffers joined to this one's by connections.
#include "runtime/Operator.h"

#include <algorithm>
#include <array>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <format>
#include <numbers>
#include <span>
#include <string>

namespace {

// Name.comp's Point, member for member: the loader holds it to the shader's by name, type
// and offset (RA03). Two vec4s, so std430 and C++ lay it out alike.
struct Point {
  glm::vec4 position{};
  glm::vec4 color{};

  static constexpr auto members() {
    return std::array{VP_MEMBER(Point, position), VP_MEMBER(Point, color)};
  }
};

constexpr float turn = 2.0f * std::numbers::pi_v<float>; // radians in a whole turn
constexpr float ring = 0.5f;                              // the points' circle, in clip space
constexpr std::uint32_t pattern_side = 8;                 // the pattern's pixels a side
constexpr glm::u8vec4 light{255, 255, 255, 255};
constexpr glm::u8vec4 dark{64, 64, 64, 255};
constexpr std::size_t shown = 8; // samples the node's command answers with, at most

// How far a whole turn every frames_per_turn frames has come at a frame, counted from the
// frame index, so it never drifts; none while frames_per_turn is 0.
float angle_at(std::uint64_t frame, std::uint32_t frames_per_turn) {
  if (frames_per_turn == 0)
    return 0.0f;
  return turn * static_cast<float>(frame % frames_per_turn) /
         static_cast<float>(frames_per_turn);
}

// Name.comp's data from C++ and back, each by the name of a field of its pass block: C++
// sets a value, writes points, fills a pattern once and reads the samples back, and the
// manifest's params reach the shader and C++ alike.
class Name final : public VP::Operator {
  // At load, and again after every swap of this folder's C++: names in, handles out, each
  // checked against Name.comp and the manifest before a frame runs (A02).
  void bind(VP::Bind &node) override {
    _angle = node.value<float>("angle");
    _points = node.upload<Point>("points");
    _samples = node.readback<float>("samples");
    _pattern = node.texture<glm::u8vec4>("pattern");
    _frames_per_turn = node.param<std::uint32_t>("frames_per_turn");
    // Every view's commands share one port, so the command carries the node's own name.
    const std::string name = node.name();
    _show = node.command(std::format("{} samples", name.substr(name.rfind('.') + 1)),
                         "answers with the first samples the node's shader wrote, as its "
                         "C++ read them back");
  }

  // Every frame, before Name.comp runs.
  void cook(VP::Cook &frame) override {
    const float angle = angle_at(frame.index(), _frames_per_turn);
    frame.set(_angle, angle);
    const std::span<Point> points = frame.write(_points);
    for (std::size_t i = 0; i < points.size(); ++i) {
      const float at =
          angle + turn * static_cast<float>(i) / static_cast<float>(points.size());
      points[i] = {.position =
                       glm::vec4(ring * std::cos(at), ring * std::sin(at), 0.0f, 1.0f),
                   .color = glm::vec4(1.0f)};
    }
    // An image keeps its pixels through rebuilds, so C++ fills it again only once emptied.
    if (frame.empty(_pattern)) {
      std::array<glm::u8vec4, pattern_side * pattern_side> pixels{};
      for (std::uint32_t pixel = 0; pixel < pixels.size(); ++pixel)
        pixels[pixel] = (pixel % pattern_side + pixel / pattern_side) % 2 == 0 ? light : dark;
      frame.upload(_pattern, pixels, {pattern_side, pattern_side});
    }
    // What the GPU wrote a frame before: none until it has written once.
    const std::span<const float> samples = frame.read(_samples);
    _read = std::min(samples.size(), _last.size());
    std::copy_n(samples.begin(), _read, _last.begin());
  }

  // When a command the node registered runs: typed, from a script, or sent by a node.
  void command(VP::Call &call) override {
    if (!call.is(_show))
      return;
    if (_read == 0)
      return call.reply("none read back yet");
    std::string text;
    for (std::size_t i = 0; i < _read; ++i)
      text += std::format("{}{:+}", i == 0 ? "" : " ", _last[i]);
    call.reply(text);
  }

  VP::Value<float> _angle;
  VP::Upload<Point> _points;
  VP::Readback<float> _samples;
  VP::Texture<glm::u8vec4> _pattern;
  std::uint32_t _frames_per_turn = 0;
  VP::Command _show;
  std::array<float, shown> _last{};
  std::size_t _read = 0;
};

} // namespace

VP_OPERATOR(Name);
