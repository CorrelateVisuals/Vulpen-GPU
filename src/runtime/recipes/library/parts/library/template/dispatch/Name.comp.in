// The dispatch's compute shader: main runs once an invocation, invocations of them, in
// workgroups of local_size_x, and each buffer it writes holds an element an invocation.
//
// Use: gl_GlobalInvocationID.x is the invocation's own element of every buffer; a write
// to another's is a race between invocations, which GPUs settle differently (GLSL02).
// Alter: main is the work; a buffer another node writes is a VP_READS field whose
// connection brings it, and one another node reads a VP_WRITES field whose connection
// takes it there. A pass that keeps a buffer between frames, as values, declares it
// VP_BUFFER and is its only reader and writer.
// Repeat: another value is a field and a param of its name, or a Value<T> in Name.cpp;
// another buffer a VP_READS, VP_WRITES or VP_BUFFER line for its element and a field;
// another image to store into an Image field, at the frame's size.
#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 64) in; // the node's invocations, 64 to a workgroup

// A point as Name.cpp writes it, member for member, which the loader holds to its own.
struct Point {
  vec4 position; // in clip space, y pointing down
  vec4 color;
};

VP_READS(Points, Point);
VP_BUFFER(Values, float);
VP_WRITES(Samples, float);

// Each field is filled before the dispatch runs, by its name: by a param, by Name.cpp,
// or through a connection; the loader refuses one that nothing fills (A02).
layout(set = 1, binding = 0) uniform Pass {
  float glide;     // a param: how far each value moves toward its target a frame
  float angle;     // set by Name.cpp every frame
  Points points;   // written by Name.cpp every frame, a point an invocation
  Values values;   // the GPU's own, kept from frame to frame
  Samples samples; // read back by Name.cpp a frame later
  Texture pattern; // filled by Name.cpp once
  Image canvas;    // stored into, at the frame's size, for a connection to a Texture
} pass;

// frame is the frame block every shader reads: its time, index, resolution and cursor.
void main() {
  const uint i = gl_GlobalInvocationID.x;
  const Point point = pass.points.at[i];
  const vec2 uv = point.position.xy * 0.5 + 0.5; // 0 to 1 across the frame
  const float target = sample_nearest(pass.pattern, uv).r * sin(frame.time + pass.angle);
  pass.values.at[i] = mix(pass.values.at[i], target, pass.glide);
  pass.samples.at[i] = pass.values.at[i];
  store(pass.canvas, ivec2(uv * vec2(frame.resolution)), point.color);
}
