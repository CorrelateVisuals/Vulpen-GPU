# The menus part: one node whose operator is Menus; it reads menu.ini, a section a kind of
# thing pressed and a line each of what the terminal does with it. menu <kind> for
# <name>... opens them: it hands on each column's words as first, second and third, for
# lists that drop below where at says, and beside the word open before them, and a line a
# press ends as handed, for the terminal to run, or to begin, for the person to finish.
# Its host names the node a begun line is typed into with the line param, which has no
# default, and the panel holding it, or that node, with shows, which it shows for one,
# as panel show finds it, and connects the keys part's typed to its typed, so escape
# shuts the menus, and the graph's place to its place, where the terminal's prompt is, so
# a path in a line handed counts from there, as the terminal takes it.
[manifest]
version = 1

[node "menus"]
