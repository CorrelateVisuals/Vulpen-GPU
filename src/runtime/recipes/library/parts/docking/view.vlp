# The docking part: one node whose operator is Docking; it registers panel move, which
# moves a panel of a dock beside another as edits of the docks that seat them, and which a
# drag of a panel's tab strip onto another panel sends. Its host hands its area the Rect
# it gives its outermost dock, on the same connection, its font the font's metrics, and
# draws its rects over the panels: a frame round where a drop would put the panel dragged,
# and, while it connects the keys part's typed to its typed, a fainter one a pixel inside
# the panel that holds the node in focus; and its labels and characters, an x at the end
# of each panel's tab strip, whose press hides the panel. A panel whose content holds a
# deck splits as one holding several, the view the deck shows going into a deck and a
# panel of its own, and goes once a deck it added holds nothing.
[manifest]
version = 1

[node "docking"]
