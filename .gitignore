# Build output: the CMake presets build under out/, an ad-hoc `cmake -B build` under build/.
/out/
/build/
# A developer's own presets; CMakePresets.json holds the shared ones.
CMakeUserPresets.json

# Editor state: clangd's index and compile-database link, Visual Studio's folder cache.
/.cache/
/compile_commands.json
/.vs/

__pycache__/

# A backup an editor leaves beside the file it saves; git history is the backup.
*.bak

# Each person's projects, and a project that is a git repository of its own; .gitkeep
# keeps the folder, and the example projects are everyone's, the triangle's variants in
# a folder of their own
/projects/*
!/projects/.gitkeep
!/projects/life/
!/projects/ray-cubes/
!/projects/triangles/
!/projects/wave/

# What the ide's parts keep beside a view: a look at the view, not the view, so each
# person's own stays out, as the panels' layout.log and the GPU a launch prefers; but where
# the graph's boxes are, graph.ini, is kept, so the library, the apps and the examples show
# as they were arranged; but not the repository top's, a person's own look at the tree.
**/.vulpen/*
!**/.vulpen/graph.ini
/.vulpen/graph.ini

# Each machine's own: run.sh and run.ps1 keep the newest 20 runs' logs in docs/logs/, which
# they make, and check.py nightly its reports in docs/reports/.
/docs/logs/
/docs/reports/
