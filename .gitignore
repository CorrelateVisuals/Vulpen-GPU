# Build output: the CMake presets build under out/, an ad-hoc `cmake -B build` under build/.
/out/
/build/
# A developer's own presets; CMakePresets.json holds the shared ones.
CMakeUserPresets.json

# Editor state: clangd's index and compile-database link, Visual Studio's folder cache.
/.cache/
/compile_commands.json
/.vs/

__pycache__/

# Archi leaves a .bak beside the model it saves; git history is the backup.
*.bak

# Each person's projects, and a project that is a git repository of its own; .gitkeep
# keeps the folder, and the example projects are everyone's
/projects/*
!/projects/.gitkeep
!/projects/triangle/
!/projects/triangle-compute/
!/projects/triangle-cpp-clock/
!/projects/triangle-cpp-corners/
!/projects/triangle-cpp-raster/
!/projects/triangle-files/
!/projects/triangle-header/
!/projects/triangle-params/
!/projects/triangle-points/
!/projects/triangle-shaders/
!/projects/triangle-twin/
!/projects/wave/

# What the ide's parts keep beside a view, as the graph its layout: a look at the view,
# not the view, so the example projects and the library leave each person's look at them out.
.vulpen/

# Each machine's own: docs/logs/ holds the session handoffs and the runs' logs, and its
# .gitkeep keeps the folder; the plans and the reports are no part of how Vulpen works,
# which docs/usage.md and docs/architecture/ say.
/docs/logs/*
!/docs/logs/.gitkeep
/docs/plans
/docs/reports
/docs/archive
