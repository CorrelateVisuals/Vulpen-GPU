# Every file a node: clock works out how far the triangle has turned and hands it on as a
# C++ object, corners turns the classic corners by it and writes them for the GPU, face
# places them, a vertex node, and blend colors the pixels between them, a fragment node,
# from the color face hands it, a varying. What two nodes share is a contract:
# contracts/Spin.h between the C++ nodes, contracts/Corner.glsl and its C++ mirror
# contracts/Corner.h between C++ and the shaders, and between the two halves of the draw
# the varying's type and location. Run ./run.sh --triangle-files.

[manifest]
version = 1

# A whole turn every 600 frames, and 0 holds the triangle still.
[node "clock"]
param = frames_per_turn=600

[node "corners"]

[node "face"]
vertex_count = 3

[node "blend"]

[connection "spin"]
from = clock.spin
to   = corners.spin

[connection "corners"]
from = corners.corners
to   = face.corners

[connection "color"]
from = face.color
to   = blend.color
