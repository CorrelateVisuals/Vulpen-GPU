#version 460
#extension GL_GOOGLE_include_directive : require
#include "baseclasses/GpuLayout.glsl"
#include "contracts/Cell.glsl"

layout(local_size_x = 64) in;

layout(set = 1, binding = 0) uniform Pass {
  float angle;    // set by the Raster operator every frame: how far the triangle turned
  uint side;      // a param: cells a row and a column, side * side invocations
  CellsOut cells; // a connection: the screen's, a cell an invocation
} pass;

// The classic triangle: its corners in clip space, y pointing down, and a color each.
const vec2 corners[3] = vec2[](vec2(0.0, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));
const vec3 colors[3] = vec3[](vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0));

// A point turned by the angle about the center.
vec2 spin(vec2 point, vec2 center, float angle) {
  const mat2 rotation = mat2(cos(angle), sin(angle), -sin(angle), cos(angle));
  return center + rotation * (point - center);
}

// Twice the area of the triangle from a to b to p, its sign the side of a to b p is on.
float edge(vec2 a, vec2 b, vec2 p) {
  return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

// Each invocation one cell: inside the triangle, the corners' colors blended by how near
// the cell's middle is to each, as a rasterizer blends them; outside, nothing at all.
void main() {
  const uint i = gl_GlobalInvocationID.x;
  const uint side = max(pass.side, 1u); // a side of 0 would divide by zero
  const float size = 2.0 / float(side);
  const vec2 corner = vec2(i % side, i / side) * size - 1.0;
  const vec2 middle = corner + 0.5 * size;
  const vec2 center = (corners[0] + corners[1] + corners[2]) / 3.0;
  const vec2 a = spin(corners[0], center, pass.angle);
  const vec2 b = spin(corners[1], center, pass.angle);
  const vec2 c = spin(corners[2], center, pass.angle);
  const vec3 weights =
      vec3(edge(b, c, middle), edge(c, a, middle), edge(a, b, middle)) / edge(a, b, c);
  const bool inside = all(greaterThanEqual(weights, vec3(0.0)));
  const vec3 color = mat3(colors[0], colors[1], colors[2]) * weights;
  pass.cells.at[i] = Cell(inside ? vec4(color, 1.0) : vec4(0.0), corner, size);
}
