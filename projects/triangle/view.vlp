# A window with one triangle, the classic one, red, green and blue blended across it. C++
# turns its corners every frame and writes each with its color into a buffer, as a vertex
# buffer is written; the shaders draw what C++ wrote. Run ./run.sh --triangle, then save
# any file of this view while it runs.

[manifest]
version = 1

# Its folder, triangle/, holds its files. A .vert and a .frag make a draw, and
# vertex_count counts its vertices. The operator reads frames_per_turn: a whole turn every
# 600 frames, and 0 holds the triangle still.
[node "triangle"]
operator     = Triangle
vertex_count = 3
param        = frames_per_turn=600
