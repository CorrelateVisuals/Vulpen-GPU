#version 460
#extension GL_GOOGLE_include_directive : require
#include "baseclasses/GpuLayout.glsl"

layout(local_size_x = 64) in;

layout(set = 1, binding = 0) uniform Pass {
  uint frames_per_turn; // a param: frames a whole turn takes; 0 holds the triangle still
  Image canvas;         // a connection: the screen's picture, at the window's size
} pass;

const float turn = 6.28318530718; // radians in a whole turn

// The classic triangle: its corners in clip space, y pointing down, and a color each.
const vec2 corners[3] = vec2[](vec2(0.0, -0.5), vec2(0.5, 0.5), vec2(-0.5, 0.5));
const vec3 colors[3] = vec3[](vec3(1.0, 0.0, 0.0), vec3(0.0, 1.0, 0.0), vec3(0.0, 0.0, 1.0));

// How far the triangle has turned this frame, counted from the frame index, so it never
// drifts.
float angle_at(uint frames_per_turn) {
  if (frames_per_turn == 0u)
    return 0.0;
  return turn * float(frame.index % frames_per_turn) / float(frames_per_turn);
}

// A point turned by the angle about the center.
vec2 spin(vec2 point, vec2 center, float angle) {
  const mat2 rotation = mat2(cos(angle), sin(angle), -sin(angle), cos(angle));
  return center + rotation * (point - center);
}

// Twice the area of the triangle from a to b to p, its sign the side of a to b p is on.
float edge(vec2 a, vec2 b, vec2 p) {
  return (b.x - a.x) * (p.y - a.y) - (b.y - a.y) * (p.x - a.x);
}

// Where a pixel's middle is, in the clip space of a square in the middle of the image:
// its shorter side spans -1 to 1.
vec2 square_of(ivec2 pixel, ivec2 size) {
  const vec2 at = (vec2(pixel) + 0.5) / vec2(size) * 2.0 - 1.0;
  return at / min(vec2(size.yx) / vec2(size), vec2(1.0));
}

// Each invocation every pixel a whole number of invocations from its own: inside the
// triangle, the corners' colors blended by how near the pixel's middle is to each, as a
// rasterizer blends them; outside, nothing at all.
void main() {
  const ivec2 size = image_size(pass.canvas);
  const uint pixels = uint(size.x * size.y);
  const uint threads = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  const float angle = angle_at(pass.frames_per_turn);
  const vec2 center = (corners[0] + corners[1] + corners[2]) / 3.0;
  const vec2 a = spin(corners[0], center, angle);
  const vec2 b = spin(corners[1], center, angle);
  const vec2 c = spin(corners[2], center, angle);
  for (uint i = gl_GlobalInvocationID.x; i < pixels; i += threads) {
    const ivec2 pixel = ivec2(i % uint(size.x), i / uint(size.x));
    const vec2 middle = square_of(pixel, size);
    const vec3 weights =
        vec3(edge(b, c, middle), edge(c, a, middle), edge(a, b, middle)) / edge(a, b, c);
    const bool inside = all(greaterThanEqual(weights, vec3(0.0)));
    const vec3 color = mat3(colors[0], colors[1], colors[2]) * weights;
    store(pass.canvas, pixel, inside ? vec4(color, 1.0) : vec4(0.0));
  }
}
