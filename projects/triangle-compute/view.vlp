# The triangle computed, with no draw of it: the raster, a compute shader, stores every
# pixel of an image the window's size, whether the turned triangle covers it and in what
# color, as a rasterizer would; the screen only shows the image, as a window needs a draw
# to show anything. No C++. Run ./run.sh --triangle-compute.

[manifest]
version = 1

# 65536 invocations, each storing every pixel that many from its own. A whole turn every
# 600 frames, and 0 holds the triangle still.
[node "raster"]
file        = Raster.comp
invocations = 65536
param       = frames_per_turn=600

# One triangle over the window, which shows the image a pixel to a texel.
[node "screen"]
file         = Screen.frag
file         = Screen.vert
vertex_count = 3

[connection "canvas"]
from = raster.canvas
to   = screen.picture
