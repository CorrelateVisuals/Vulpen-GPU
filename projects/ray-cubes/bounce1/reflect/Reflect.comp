// Each ray sent on from the cube it met, mirrored about its face, carrying the part of
// the light the face mirrors, tinted a little by its color; a ray that met nothing, or
// ended, or would carry too little to see, ends.
#include "baseclasses/GpuLayout.glsl"
#include "contracts/Hit.glsl"
#include "contracts/Ray.glsl"
#include "shared/Shading.glsl"

layout(local_size_x = 64) in; // a pixel an invocation

layout(set = 1, binding = 0) uniform Pass {
  float tint;      // a param: how much of a cube's color its mirror lends what it shows
  Rays rays;       // a connection: the rays this bounce traced
  Hits hits;       // a connection: this bounce's trace's
  RaysOut bounced; // a connection: to the next bounce, or sky
} pass;

// Of the light a ray carries to the eye, the least worth tracing on: the bounces after
// would add less than a step of the picture's 8 bits, and ended rays cost the next
// bounce's trace and shadow nothing.
const float faint = 0.02;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const Ray ray = pass.rays.at[i];
  if (!goes_on(ray)) {
    pass.bounced.at[i] = ray;
    return;
  }
  const Hit hit = pass.hits.at[i];
  const vec4 look = unpackUnorm4x8(hit.look);
  const float mirrored = fresnel(look.a, dot(hit.normal, -ray.direction));
  vec3 carried = weight_of(ray) * mirrored * mix(vec3(1.0), look.rgb, pass.tint);
  if (hit.position.w < 0.0 || max(carried.r, max(carried.g, carried.b)) < faint)
    carried = vec3(0.0);
  pass.bounced.at[i] = ray_of(hit.position.xyz + nudge * hit.normal,
                              reflect(ray.direction, hit.normal),
                              carried);
}
