// Spots along the picture's middle row, the light gathered at each, for Meter.cpp to read
// back a frame later.
#include "baseclasses/GpuLayout.glsl"
#include "contracts/Color.glsl"

layout(local_size_x = 8) in; // a spot an invocation

layout(set = 1, binding = 0) uniform Pass {
  uvec2 size;      // a param: the picture's pixels across and down, as rays casts them
  Colors gathered; // a connection: sky's
  ColorsOut spots; // read back by Meter.cpp
} pass;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const uint spots = gl_NumWorkGroups.x * gl_WorkGroupSize.x;
  const uvec2 size = max(pass.size, uvec2(1u));
  const uint x = min((2u * i + 1u) * size.x / (2u * spots), size.x - 1u);
  pass.spots.at[i] = pass.gathered.at[(size.y / 2u) * size.x + x];
}
