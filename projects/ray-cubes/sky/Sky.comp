// What the rays still going after the last bounce find: the sky, as if no cube stood in
// their way any more, added to the light gathered.
#include "baseclasses/GpuLayout.glsl"
#include "contracts/Color.glsl"
#include "contracts/Ray.glsl"
#include "shared/Shading.glsl"

layout(local_size_x = 64) in; // a pixel an invocation

layout(set = 1, binding = 0) uniform Pass {
  Rays rays;       // a connection: the last bounce's reflect's
  Colors before;   // a connection: the last bounce's shade's
  ColorsOut after; // a connection: to tone and meter
} pass;

void main() {
  const uint i = gl_GlobalInvocationID.x;
  const Ray ray = pass.rays.at[i];
  const vec3 found = ray.weight.a == 0.0 ? vec3(0.0) : sky(ray.direction.xyz);
  pass.after.at[i] = pass.before.at[i] + vec4(ray.weight.rgb * found, 0.0);
}
