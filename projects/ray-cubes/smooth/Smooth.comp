// The gathered light with its edges smoothed, as FXAA smooths them: where the light steps
// sharply between a pixel's corners, as along a cube's outline, the pixel takes the light
// along the edge, so an edge a ray a pixel draws as a staircase reads as a line;
// elsewhere the light passes as it is.
#include "baseclasses/GpuLayout.glsl"
#include "contracts/Color.glsl"
#include "shared/Picture.glsl"

layout(local_size_x = 64) in; // a pixel an invocation

layout(set = 1, binding = 0) uniform Pass {
  uvec2 size;      // a param: the picture's pixels across and down, as rays casts them
  Colors before;   // a connection: sky's
  ColorsOut after; // a connection: to tone
} pass;

const vec3 lumas = vec3(0.299, 0.587, 0.114); // how bright red, green and blue look
const float reduce_least = 1.0 / 128.0;       // FXAA's: the least the edge's slope gives
const float reduce_share = 1.0 / 8.0;         // and the share of the corners' luma it adds
const float reach = 8.0;                      // the farthest it looks along an edge, pixels

// How bright light looks once squeezed in as tone squeezes it, so an edge is found as it
// will show.
float luma(vec3 light) {
  return dot(sqrt(1.0 - exp(-light)), lumas);
}

// The edge's way runs across the steps between the corners, so the light taken along it
// stays on one side of the edge; two blends near the pixel, or four reaching further,
// whichever stays within the brightness around it.
void main() {
  const uint i = gl_GlobalInvocationID.x;
  const uvec2 size = max(pass.size, uvec2(1u));
  const ivec2 pixel = ivec2(i % size.x, i / size.x);
  const float nw = luma(light_at(pass.before, size, pixel + ivec2(-1, -1)));
  const float ne = luma(light_at(pass.before, size, pixel + ivec2(1, -1)));
  const float sw = luma(light_at(pass.before, size, pixel + ivec2(-1, 1)));
  const float se = luma(light_at(pass.before, size, pixel + ivec2(1, 1)));
  const float middle = luma(light_at(pass.before, size, pixel));
  const float least = min(middle, min(min(nw, ne), min(sw, se)));
  const float most = max(middle, max(max(nw, ne), max(sw, se)));
  const vec2 slope = vec2((sw + se) - (nw + ne), (nw + sw) - (ne + se));
  const float reduce = max((nw + ne + sw + se) * 0.25 * reduce_share, reduce_least);
  const vec2 way = clamp(slope / (min(abs(slope.x), abs(slope.y)) + reduce), -reach, reach);
  const vec2 at = vec2(pixel) + 0.5;
  const vec3 near = 0.5 * (blended(pass.before, size, at - way / 6.0) +
                           blended(pass.before, size, at + way / 6.0));
  const vec3 far = 0.5 * near + 0.25 * (blended(pass.before, size, at - way * 0.5) +
                                        blended(pass.before, size, at + way * 0.5));
  const float far_luma = luma(far);
  pass.after.at[i] = vec4(far_luma < least || far_luma > most ? near : far, 0.0);
}
