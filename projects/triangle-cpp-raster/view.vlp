# Almost all on the CPU: the raster's operator turns the corners and fills every cell of a
# 256 by 256 grid itself, as software rendering does, the same lines triangle-compute's
# shader runs, now in C++ through glm; its compute shader only unpacks each cell's four
# bytes and places it, and the screen shows a square a cell. 256 KB cross to the GPU a
# frame: probe stats and the graph's heat show what that costs. Run
# ./run.sh --triangle-cpp-raster.

[manifest]
version = 1

# side * side invocations, a cell each: 256 * 256 = 65536. The operator reads
# frames_per_turn and side, and the shader side too: a whole turn every 600 frames, and
# 0 holds the triangle still.
[node "raster"]
operator    = Raster
invocations = 65536
param       = frames_per_turn=600
param       = side=256

# As many squares as the raster writes cells, six vertices each.
[node "screen"]
vertex_count   = 6
instance_count = cells

[connection "cells"]
from = raster.cells
to   = screen.cells
