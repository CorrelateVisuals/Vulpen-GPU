#version 460
#extension GL_GOOGLE_include_directive : require
#include "baseclasses/GpuLayout.glsl"
#include "contracts/Corner.glsl"

layout(local_size_x = 1) in; // one point, one invocation

// Every value a param of the node, which the engine writes at load and after each edit.
layout(set = 1, binding = 0) uniform Pass {
  vec2 at;           // in clip space, y pointing down
  vec3 color;        // red, green and blue
  CornersOut corner; // a connection: one of the face's corners
} pass;

void main() {
  pass.corner.at[0] = Corner(vec4(pass.at, 0.0, 1.0), vec4(pass.color, 1.0));
}
