# Almost all on the GPU, C++ the clock alone: the raster's operator works out how far the
# triangle has turned from the frame index and sets it in the pass block; its compute
# shader does the rest, turning the corners and filling every cell of a 256 by 256 grid,
# which the screen shows a square a cell. Run ./run.sh --triangle-cpp-clock.

[manifest]
version = 1

# side * side invocations, a cell each: 256 * 256 = 65536. The operator reads
# frames_per_turn: a whole turn every 600 frames, and 0 holds the triangle still.
[node "raster"]
invocations = 65536
param       = frames_per_turn=600
param       = side=256

# As many squares as the raster writes cells, six vertices each.
[node "screen"]
vertex_count   = 6
instance_count = cells

[connection "cells"]
from = raster.cells
to   = screen.cells
